## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
.verify-build/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ==========================================
# ARS Project Specific Extensions
# ==========================================

# 1. IDE Configuration (Sửa lỗi Permission Denied lúc nãy)
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# 2. Database & SQL Server Local (Tránh đẩy file DB cục bộ lên mạng)
*.mdf
*.ldf
*.db
*.sqlite

# 3. User Secrets & Sensitive Configuration (Tránh lộ mật khẩu DB, API Key Gemini)
appsettings.Development.json
secrets.json
*.pem
*.pfx

# 4. User Uploaded Files (Tránh đẩy các file CV .pdf do bạn upload thử nghiệm lên GitHub)
WebApp/wwwroot/uploads/
[Ww][Ww][Ww][Rr][Oo][Oo][Tt]/uploads/
