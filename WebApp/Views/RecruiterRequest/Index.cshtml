@using Domain.Entities
@using Domain.Enums
@model WebApp.Models.RecruiterRequest.CreateRecruiterRequestViewModel
@{
    ViewData["Title"] = "Đăng ký nhà tuyển dụng";
    var latest = ViewBag.LatestRequest as RecruiterRequest;
    string statusText = latest?.Status switch
    {
        RecruiterRequestStatus.Pending => "Đang chờ Admin duyệt",
        RecruiterRequestStatus.Approved => "Đã được duyệt",
        RecruiterRequestStatus.Rejected => "Đã bị từ chối",
        _ => string.Empty
    };
    string statusClass = latest?.Status switch
    {
        RecruiterRequestStatus.Pending => "warning",
        RecruiterRequestStatus.Approved => "success",
        RecruiterRequestStatus.Rejected => "danger",
        _ => "secondary"
    };
}

<div class="container py-5" style="max-width:900px">
    <div class="mb-4">
        <span class="badge bg-primary bg-opacity-10 text-primary mb-2">DÀNH CHO ỨNG VIÊN</span>
        <h1 class="fw-bold">Đăng ký trở thành nhà tuyển dụng</h1>
        <p class="text-muted">Gửi thông tin doanh nghiệp để Admin xác minh và cấp quyền Recruiter.</p>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

    @if (latest != null)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h5 class="fw-bold mb-2">Yêu cầu gần nhất</h5>
                    <div><strong>@latest.CompanyName</strong> · MST: @latest.TaxCode</div>
                    <small class="text-muted">Gửi lúc @latest.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                    @if (!string.IsNullOrWhiteSpace(latest.AdminNotes))
                    {
                        <div class="mt-3 p-3 rounded bg-light"><strong>Phản hồi Admin:</strong> @latest.AdminNotes</div>
                    }
                </div>
                <span class="badge bg-@statusClass fs-6">@statusText</span>
            </div>
        </div>
    }

    @if (latest?.Status != RecruiterRequestStatus.Pending)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-4">
                        <div class="col-md-7">
                            <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                            <input asp-for="CompanyName" class="form-control form-control-lg" placeholder="Ví dụ: Công ty TNHH ABC" />
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="TaxCode" class="form-label fw-semibold"></label>
                            <input asp-for="TaxCode" class="form-control form-control-lg" placeholder="Mã số thuế doanh nghiệp" />
                            <span asp-validation-for="TaxCode" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Document" class="form-label fw-semibold"></label>
                            <input asp-for="Document" class="form-control form-control-lg" accept=".pdf,.jpg,.jpeg,.png" />
                            <div class="form-text">Chấp nhận PDF, JPG, JPEG, PNG; tối đa 5MB.</div>
                            <span asp-validation-for="Document" class="text-danger"></span>
                        </div>
                    </div>
                    <button class="btn btn-primary btn-lg rounded-pill px-5 mt-4" type="submit"
                            onclick="return confirm('Xác nhận gửi hồ sơ đăng ký nhà tuyển dụng?')">
                        <i class="bi bi-send me-2"></i>Gửi yêu cầu cho Admin
                    </button>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
