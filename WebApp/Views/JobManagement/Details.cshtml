@model Services.DTOs.JobPosting.JobDto

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết Bài đăng Tuyển dụng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Chi tiết Bài đăng Tuyển dụng</h3>
        <p class="text-muted mb-0">Quản lý nội dung bài đăng và danh sách ứng viên ứng tuyển.</p>
    </div>
    <div class="d-flex gap-2">
        <!-- Edit should go to JobPosting controller which handles edit/create of postings -->
        <a asp-controller="JobPosting" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i> Chỉnh sửa
        </a>
        <a asp-controller="JobManagement" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="badge bg-light text-primary border mb-2 fs-8">
                            <i class="bi bi-tag me-1"></i>@(string.IsNullOrEmpty(Model.JobCategoryName) ? "Chua ph�n lo?i" : Model.JobCategoryName)
                        </span>
                        <h2 class="fw-bold text-dark mb-2">@Model.Title</h2>
                        <h5 class="mb-0">
                            <a asp-controller="UserManagement" asp-action="Details" asp-route-userId="@Model.RecruiterId" class="text-primary text-decoration-none fw-semibold fs-6">
                                <i class="bi bi-building me-1"></i>@Model.CompanyName
                            </a>
                        </h5>
                    </div>
                    <div>
                        @if (string.Equals(Model.Status, "Active", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-7">
                                <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                            </span>
                        }
                        else if (string.Equals(Model.Status, "Draft", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 fs-7">
                                <i class="bi bi-pencil-square me-1"></i> Bản nháp
                            </span>
                        }
                        else if (string.Equals(Model.Status, "Closed", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-7">
                                <i class="bi bi-x-circle-fill me-1"></i> �� d�ng
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 fs-7">
                                <i class="bi bi-archive-fill me-1"></i> Lưu trữ
                            </span>
                        }
                    </div>
                </div>

                <hr class="my-4" />

                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-file-earmark-text text-primary me-2"></i>Mô tả công việc</h5>
                    <div class="p-3 bg-light rounded text-secondary" style="white-space: pre-line;">
                        @Model.Description
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-check2-square text-primary me-2"></i>Yêu cầu ứng viên</h5>
                    <div class="p-3 bg-light rounded text-secondary" style="white-space: pre-line;">
                        @Model.Requirements
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Benefits))
                {
                    <div class="mb-2">
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-gift text-primary me-2"></i>Quyền lợi được hưởng</h5>
                        <div class="p-3 bg-light rounded text-secondary" style="white-space: pre-line;">
                            @Model.Benefits
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="accordion" id="applicationsAccordion">
                <div class="accordion-item border-0">
                    <h2 class="accordion-header" id="headingApplications">
                        <button class="accordion-button collapsed bg-white py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseApplications" aria-expanded="false" aria-controls="collapseApplications">
                            <div class="d-flex align-items-center justify-content-between w-100 me-3">
                                <span class="fw-bold fs-5 text-primary">
                                    <i class="bi bi-people-fill me-2"></i>Danh s�ch H? so d� ?ng tuy?n
                                </span>
                                <span class="badge bg-primary rounded-pill px-3 py-2">
                                    @(Model.Applications?.Count ?? 0) Ứng viên
                                </span>
                            </div>
                        </button>
                    </h2>
                    <div id="collapseApplications" class="accordion-collapse collapse" aria-labelledby="headingApplications" data-bs-parent="#applicationsAccordion">
                        <div class="accordion-body p-0 border-top">
                            @if (Model.Applications != null && Model.Applications.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-4">ID</th>
                                                <th>Tên Ứng viên</th>
                                                <th>Ngày ứng tuyển</th>
                                                <th>Trạng thái</th>
                                                <th class="text-end pe-4">Chi tiết</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var app in Model.Applications)
                                            {
                                                <tr>
                                                    <td class="ps-4 fw-bold text-secondary">#@app.Id</td>
                                                    <td>
                                                        <a asp-controller="UserManagement" asp-action="Details" asp-route-userId="@app.CandidateId" class="fw-bold text-dark text-decoration-none">
                                                            <i class="bi bi-person-circle me-1 text-primary"></i>@app.CandidateName
                                                        </a>
                                                    </td>
                                                    <td class="text-muted fs-7">
                                                        <i class="bi bi-clock me-1"></i>@app.AppliedAt.ToString("dd/MM/yyyy HH:mm")
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                            @app.Status
                                                        </span>
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        <a asp-controller="Application" asp-action="Details" asp-route-id="@app.Id" class="btn btn-sm btn-light border" title="Xem chi tiết đơn ứng tuyển">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Chưa có ứng viên nào nộp hồ sơ vào bài đăng này.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle me-2 text-primary"></i>Thông tin tổng quan</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="text-muted fs-7 d-block mb-1">Mức lương</label>
                    <span class="fw-bold text-success fs-6">
                        <i class="bi bi-cash-stack me-1"></i>
                        @if (Model.MinSalary.HasValue && Model.MaxSalary.HasValue)
                        {
                            @($"{Model.MinSalary.Value:N0} - {Model.MaxSalary.Value:N0} VNĐ")
                        }
                        else if (Model.MinSalary.HasValue)
                        {
                            @($"Từ {Model.MinSalary.Value:N0} VNĐ")
                        }
                        else if (Model.MaxSalary.HasValue)
                        {
                            @($"Đến {Model.MaxSalary.Value:N0} VNĐ")
                        }
                        else
                        {
                            <span>Thỏa thuận</span>
                        }
                    </span>
                </div>

                <div class="mb-3">
                    <label class="text-muted fs-7 d-block mb-1">Địa điểm làm việc</label>
                    <span class="fw-medium text-dark">
                        <i class="bi bi-geo-alt me-1 text-danger"></i>@Model.Location
                    </span>
                </div>

                <div class="mb-3">
                    <label class="text-muted fs-7 d-block mb-1">Hình thức làm việc</label>
                    <span class="fw-medium text-dark">
                        <i class="bi bi-briefcase me-1 text-primary"></i>@Model.JobType
                    </span>
                </div>

                <div class="mb-3">
                    <label class="text-muted fs-7 d-block mb-1">Môi trường làm việc</label>
                    <span class="fw-medium text-dark">
                        <i class="bi bi-laptop me-1 text-info"></i>@Model.WorkMode
                    </span>
                </div>

                <div class="mb-3">
                    <label class="text-muted fs-7 d-block mb-1">Số lượng tuyển dụng</label>
                    <span class="fw-medium text-dark">
                        <i class="bi bi-person-plus me-1 text-warning"></i>@Model.Vacancies người
                    </span>
                </div>

                <hr />

                <div class="mb-3">
                    <label class="text-muted fs-7 d-block mb-1">Ngày đăng bài</label>
                    <span class="fw-medium text-dark">
                        <i class="bi bi-calendar-check me-1 text-muted"></i>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div>
                    <label class="text-muted fs-7 d-block mb-1">Hạn nộp hồ sơ</label>
                    <span class="fw-medium @(Model.ExpiredAt < DateTime.UtcNow ? "text-danger" : "text-dark")">
                        <i class="bi bi-calendar-x me-1"></i>@Model.ExpiredAt.ToString("dd/MM/yyyy")
                        @if (Model.ExpiredAt < DateTime.UtcNow)
                        {
                            <small class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1">�� h?t h?n</small>
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
