@model IEnumerable<Services.DTOs.JobPosting.JobListItem>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danh sách bài đăng tuyển dụng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Danh sách Bài đăng Tuyển dụng</h3>
        <p class="text-muted mb-0">Quản lý và theo dõi danh sách tin tuyển dụng trong hệ thống.</p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchTerm" class="form-control border-start-0" placeholder="Tìm theo tiêu đề bài đăng..." value="@Context.Request.Query["searchTerm"]" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Active" selected="@(Context.Request.Query["status"] == "Active")">Hoạt động (Active)</option>
                    <option value="Draft" selected="@(Context.Request.Query["status"] == "Draft")">Bản nháp (Draft)</option>
                    <option value="Closed" selected="@(Context.Request.Query["status"] == "Closed")">Đã đóng (Closed)</option>
                    <option value="Archived" selected="@(Context.Request.Query["status"] == "Archived")">Lưu trữ (Archived)</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="text" name="category" class="form-control" placeholder="Lọc theo ngành nghề..." value="@Context.Request.Query["category"]" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                <p class="text-muted fw-medium mb-0">Không tìm thấy bài đăng tuyển dụng nào.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th>Tiêu đề / Ngành nghề</th>
                            <th class="text-center">Ứng tuyển</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th>Ngày hết hạn</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@item.Id</td>
                                <td>
                                    <a asp-action="Details" asp-route-jobId="@item.Id" class="fw-bold text-dark text-decoration-none d-block mb-1">
                                        @item.Title
                                    </a>
                                    <span class="badge bg-light text-secondary border fw-normal fs-8">
                                        <i class="bi bi-tag me-1"></i>@(string.IsNullOrEmpty(item.JobCategoryName) ? "Chưa phân loại" : item.JobCategoryName)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Application" asp-action="Index" asp-route-jobId="@item.Id" class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill text-decoration-none px-3 py-2 fs-7">
                                        <i class="bi bi-people-fill me-1"></i>@item.ApplicationsCount Hồ sơ
                                    </a>
                                </td>
                                <td>
                                    @if (string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                                        </span>
                                    }
                                    else if (string.Equals(item.Status, "Draft", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-pencil-square me-1"></i> Bản nháp
                                        </span>
                                    }
                                    else if (string.Equals(item.Status, "Closed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> Đã đóng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-archive-fill me-1"></i> Lưu trữ
                                        </span>
                                    }
                                </td>
                                <td class="text-muted fs-7">
                                    <i class="bi bi-calendar-check me-1"></i>@item.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                                <td class="fs-7">
                                    @if (item.ExpiredAt < DateTime.UtcNow)
                                    {
                                        <span class="text-danger fw-medium" title="Đã hết hạn">
                                            <i class="bi bi-exclamation-circle me-1"></i>@item.ExpiredAt.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>@item.ExpiredAt.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-jobId="@item.Id">
                                                    <i class="bi bi-eye text-primary me-2"></i>Xem chi tiết
                                                </a>
                                            </li>
                                            @if (string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="CloseJob" asp-route-jobId="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn gỡ bài đăng này xuống?');">
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-slash-circle me-2"></i>Gỡ bài đăng
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>