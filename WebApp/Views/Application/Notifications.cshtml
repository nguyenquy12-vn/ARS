@using Domain.Entities
@model List<Notification>

@{
    ViewData["Title"] = "Thông báo tuyển dụng";
    var unreadCount = Model.Count(n => !n.IsRead);

    string TimeAgo(DateTime dateTime)
    {
        var elapsed = DateTime.UtcNow - dateTime;
        if (elapsed.TotalMinutes < 1) return "Vừa xong";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes} phút trước";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours} giờ trước";
        if (elapsed.TotalDays < 7) return $"{(int)elapsed.TotalDays} ngày trước";
        return dateTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }
}

<div class="recruiter-notifications-page">
    <div class="recruiter-notifications-heading">
        <div>
            <div class="recruiter-page-kicker"><i class="bi bi-lightning-charge-fill"></i> Cập nhật tuyển dụng</div>
            <h1>Thông báo</h1>
            <p>CV mới được gửi đến sẽ xuất hiện tại đây để bạn xử lý nhanh.</p>
        </div>
        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn recruiter-mark-all"><i class="bi bi-check2-all"></i> Đánh dấu đã đọc</button>
            </form>
        }
    </div>

    @if (Model.Any())
    {
        <div class="recruiter-notifications-summary"><strong>@unreadCount</strong> thông báo chưa đọc trên tổng số @Model.Count thông báo.</div>
        <div class="recruiter-notifications-list">
            @foreach (var notification in Model)
            {
                var isNewApplication = notification.Type == "NewApplication";
                <article class="recruiter-notification-card @(notification.IsRead ? "" : "unread")">
                    <div class="recruiter-notification-icon @(isNewApplication ? "new-cv" : "general")">
                        <i class="bi @(isNewApplication ? "bi-file-earmark-person-fill" : "bi-bell-fill")"></i>
                    </div>
                    <div class="recruiter-notification-body">
                        <div class="recruiter-notification-title">@notification.Title</div>
                        <div class="recruiter-notification-message">@notification.Message</div>
                        <div class="recruiter-notification-time"><i class="bi bi-clock"></i> @TimeAgo(notification.CreatedAt)</div>
                    </div>
                    <div class="recruiter-notification-actions">
                        @if (isNewApplication && notification.RelatedId.HasValue)
                        {
                            <a asp-action="ByJob" asp-route-id="@notification.RelatedId" class="btn recruiter-review-btn">Duyệt CV <i class="bi bi-arrow-right"></i></a>
                        }
                        @if (!notification.IsRead)
                        {
                            <form asp-action="MarkRead" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@notification.Id" />
                                <button type="submit" class="recruiter-mark-read">Đã đọc</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="recruiter-notifications-empty">
            <div><i class="bi bi-bell-slash"></i></div>
            <h3>Chưa có thông báo mới</h3>
            <p>Khi ứng viên nộp CV vào các tin của bạn, thông báo sẽ xuất hiện tại đây.</p>
        </div>
    }
</div>

<style>
    .recruiter-notif-bell { position:relative; display:grid; width:37px; height:37px; place-items:center; border:1px solid #dce7ef; border-radius:10px; color:#31698e; background:#fff; text-decoration:none; transition:.2s; }.recruiter-notif-bell:hover { color:#0b3658; background:#eaf5fb; border-color:#a9cde5; }.recruiter-notif-badge { position:absolute; top:-5px; right:-6px; min-width:18px; height:18px; padding:0 4px; border:2px solid #fff; border-radius:10px; color:#fff; background:#f56c6c; font-size:10px; font-weight:800; line-height:14px; text-align:center; }
    .recruiter-notifications-page { max-width:980px; }.recruiter-notifications-heading { display:flex; justify-content:space-between; align-items:flex-end; gap:24px; margin-bottom:26px; }.recruiter-page-kicker { color:#3982bb; font-size:.78rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }.recruiter-notifications-heading h1 { margin:4px 0; font-size:2rem; font-weight:800; }.recruiter-notifications-heading p { margin:0; color:#688dac; }.recruiter-mark-all { padding:9px 14px; border:1px solid #bdd9ea; border-radius:9px; color:#23658e; background:#fff; font-size:.86rem; font-weight:700; }.recruiter-mark-all:hover { color:#fff; background:#377fb6; border-color:#377fb6; }
    .recruiter-notifications-summary { margin-bottom:14px; color:#688dac; font-size:.87rem; }.recruiter-notifications-summary strong { color:#0b3658; }.recruiter-notifications-list { display:grid; gap:12px; }.recruiter-notification-card { display:flex; align-items:flex-start; gap:15px; padding:18px; border:1px solid #dde7ee; border-radius:16px; background:#fff; box-shadow:0 4px 12px rgba(11,54,88,.04); transition:.2s; }.recruiter-notification-card:hover { border-color:#b9d6e8; box-shadow:0 12px 26px rgba(11,54,88,.08); transform:translateY(-2px); }.recruiter-notification-card.unread { border-left:4px solid #4e9ad9; background:linear-gradient(90deg,#f4fbff 0%,#fff 36%); }.recruiter-notification-icon { display:grid; flex:0 0 46px; width:46px; height:46px; place-items:center; border-radius:13px; font-size:1.25rem; }.recruiter-notification-icon.new-cv { color:#176e9e; background:#e2f3fc; }.recruiter-notification-icon.general { color:#7b62bd; background:#f0ebff; }.recruiter-notification-body { flex:1; min-width:0; }.recruiter-notification-title { margin-bottom:3px; color:#0b3658; font-size:.98rem; font-weight:800; }.recruiter-notification-message { color:#59758d; font-size:.88rem; line-height:1.55; }.recruiter-notification-time { margin-top:7px; color:#8aa4b8; font-size:.76rem; font-weight:600; }.recruiter-notification-time i { margin-right:3px; }.recruiter-notification-actions { display:flex; flex-direction:column; align-items:flex-end; gap:10px; }.recruiter-review-btn { display:inline-flex; align-items:center; gap:6px; padding:8px 11px; border-radius:8px; color:#fff; background:#377fb6; font-size:.79rem; font-weight:700; white-space:nowrap; }.recruiter-review-btn:hover { color:#fff; background:#0b5c8d; }.recruiter-mark-read { border:0; color:#4e7c9d; background:transparent; font-size:.76rem; font-weight:700; }.recruiter-mark-read:hover { color:#0b3658; text-decoration:underline; }.recruiter-notifications-empty { padding:64px 25px; border:1px dashed #c8d8e4; border-radius:18px; background:#fff; text-align:center; }.recruiter-notifications-empty div { display:grid; width:64px; height:64px; margin:0 auto 16px; place-items:center; border-radius:20px; color:#7ba9c6; background:#eaf5fb; font-size:1.8rem; }.recruiter-notifications-empty h3 { font-size:1.1rem; font-weight:800; }.recruiter-notifications-empty p { max-width:420px; margin:7px auto 0; color:#688dac; font-size:.9rem; }
    @@media (max-width: 640px) { .recruiter-notifications-heading { align-items:flex-start; flex-direction:column; }.recruiter-notification-card { flex-wrap:wrap; }.recruiter-notification-body { width:calc(100% - 61px); flex:auto; }.recruiter-notification-actions { width:100%; flex-direction:row; justify-content:space-between; padding-left:61px; }.recruiter-notifications-heading h1 { font-size:1.7rem; } }
</style>
