@model WebApp.Models.Application.JobApplicantsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Ứng viên: " + Model.Job.Title;
    var total = Model.Applicants.Count();
    var graded = Model.Applicants.Count(a => a.AiMatchScore.HasValue);
    var avgScore = graded > 0
        ? Model.Applicants.Where(a => a.AiMatchScore.HasValue).Average(a => a.AiMatchScore!.Value)
        : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Ứng viên ứng tuyển</h3>
        <div class="text-muted">@Model.Job.Title</div>
    </div>
    <div class="d-flex gap-2 flex-wrap justify-content-end">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#scoreSettings">
            <i class="bi bi-sliders me-1"></i> Cài đặt chấm điểm
        </button>
        <button type="button" class="btn btn-primary btn-sm" onclick="startScoring(false)" id="btnScoreNew">
            <i class="bi bi-clipboard-check me-1"></i> Chấm điểm (chưa chấm)
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="if(confirm('Chấm lại toàn bộ ứng viên theo JD?')) startScoring(true)" id="btnScoreAll">
            <i class="bi bi-arrow-repeat me-1"></i> Chấm lại tất cả
        </button>
        <a asp-controller="JobPosting" asp-action="Details" asp-route-id="@Model.Job.Id"
           class="btn btn-outline-secondary btn-sm">← Quay lại tin</a>
    </div>
</div>

@Html.AntiForgeryToken()

<!-- Thanh tiến trình chấm điểm -->
<div class="card shadow-sm border-0 mb-3" id="scoreProgress" style="display:none;">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold" id="scoreProgressLabel">Đang chuẩn bị...</span>
            <span class="text-muted small" id="scoreProgressCount">0 / 0</span>
        </div>
        <div class="progress" style="height: 8px;">
            <div class="progress-bar" id="scoreProgressBar" role="progressbar" style="width: 0%;"></div>
        </div>
    </div>
</div>

<!-- Cài đặt chấm điểm theo JD -->
<div class="collapse mb-4" id="scoreSettings">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h6 class="fw-bold mb-1">Cài đặt chấm điểm cho tin này</h6>
            <p class="text-muted small mb-3">Đặt trọng số ưu tiên (tổng nên = 100%) và ghi chú must-have. AI sẽ chấm điểm ứng viên dựa trên các thiết lập này.</p>
            <form asp-action="SaveScoreSettings" asp-route-id="@Model.Job.Id" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-6 col-md-2">
                    <label class="form-label small text-muted mb-1">Kinh nghiệm (%)</label>
                    <input type="number" name="WeightExperience" value="@Model.Job.AiWeightExperience" min="0" max="100" class="form-control" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small text-muted mb-1">Kỹ năng (%)</label>
                    <input type="number" name="WeightSkills" value="@Model.Job.AiWeightSkills" min="0" max="100" class="form-control" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small text-muted mb-1">Học vấn (%)</label>
                    <input type="number" name="WeightEducation" value="@Model.Job.AiWeightEducation" min="0" max="100" class="form-control" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small text-muted mb-1">Thành tựu (%)</label>
                    <input type="number" name="WeightAchievement" value="@Model.Job.AiWeightAchievement" min="0" max="100" class="form-control" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">Ưu tiên / must-have</label>
                    <input type="text" name="PriorityNote" value="@Model.Job.AiPriorityNote" class="form-control"
                           placeholder="VD: bắt buộc có React + 2 năm, ưu tiên tiếng Anh tốt..." />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-sm">Lưu cài đặt</button>
                    <span class="text-muted small ms-2">Sau khi lưu, bấm <strong>Chấm lại tất cả</strong> để áp dụng.</span>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Thống kê -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body">
                <div class="display-6 fw-bold">@total</div>
                <div class="text-muted small">Tổng đơn</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body">
                <div class="display-6 fw-bold text-primary">@graded</div>
                <div class="text-muted small">Đã chấm AI</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body">
                <div class="display-6 fw-bold">@(graded > 0 ? avgScore.ToString("0") : "—")</div>
                <div class="text-muted small">Điểm AI trung bình</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body">
                <div class="display-6 fw-bold text-secondary">@(total - graded)</div>
                <div class="text-muted small">Chưa chấm</div>
            </div>
        </div>
    </div>
</div>

<div class="text-muted small mb-2">Hiển thị @total ứng viên</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tên</th>
                    <th>Title</th>
                    <th class="text-center">KN tổng</th>
                    <th>Loại</th>
                    <th>Skills</th>
                    <th>Tóm tắt</th>
                    <th class="text-center">Điểm AI</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">File</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Applicants.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-5">
                            Chưa có ứng viên nào nộp hồ sơ cho tin tuyển dụng này.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var a in Model.Applicants)
                    {
                        var initial = string.IsNullOrWhiteSpace(a.CandidateName) ? "?" : a.CandidateName.Trim()[..1].ToUpper();
                        <tr id="row-@a.Id" data-app-id="@a.Id" data-scored="@(a.HasScore ? 1 : 0)" data-name="@a.CandidateName">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="r-avatar">@initial</div>
                                    <div>
                                        <a role="button" class="text-decoration-none fw-semibold"
                                           onclick="openApplicantMatch(this)"
                                           data-name="@a.CandidateName"
                                           data-email="@a.CandidateEmail"
                                           data-score="@(a.AiMatchScore?.ToString() ?? "")"
                                           data-verdict="@a.Verdict"
                                           data-recommendation="@a.Recommendation"
                                           data-summary="@a.MatchSummary"
                                           data-matched="@JsonSerializer.Serialize(a.MatchedSkills)"
                                           data-missing="@JsonSerializer.Serialize(a.MissingSkills)"
                                           data-strengths="@JsonSerializer.Serialize(a.MatchStrengths)"
                                           data-concerns="@JsonSerializer.Serialize(a.MatchConcerns)"
                                           data-pdf="@a.ResumeFilePath">
                                            @a.CandidateName
                                        </a>
                                        <div class="text-muted small">@a.CandidateEmail</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(a.CvTitle) ? "—" : a.CvTitle)</td>
                            <td class="text-center">@(a.TotalYears.HasValue ? a.TotalYears.Value.ToString("0.#") + "y" : "—")</td>
                            <td>
                                @if (a.IsFresher == true)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis">Fresher</span>
                                }
                                else if (a.TotalYears.HasValue)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">@a.TotalYears.Value.ToString("0.#")y+</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td style="max-width: 220px;">
                                @if (a.Skills.Any())
                                {
                                    foreach (var skill in a.Skills.Take(6))
                                    {
                                        <span class="badge rounded-pill bg-light text-dark border me-1 mb-1">@skill</span>
                                    }
                                    @if (a.Skills.Count > 6)
                                    {
                                        <span class="text-muted small">+@(a.Skills.Count - 6)</span>
                                    }
                                }
                                else
                                {
                                    <span class="r-no-score">Chưa phân tích</span>
                                }
                            </td>
                            <td style="max-width: 260px;">
                                @if (!string.IsNullOrWhiteSpace(a.Summary))
                                {
                                    <div class="r-clamp2">@a.Summary</div>
                                }
                                else
                                {
                                    <span class="r-no-score">—</span>
                                }
                            </td>
                            <td class="text-center" id="score-@a.Id">
                                @if (a.AiMatchScore.HasValue)
                                {
                                    <span class="r-score @ScoreClass(a.AiMatchScore.Value)">
                                        @a.AiMatchScore<span class="unit">/100</span>
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(a.Verdict))
                                    {
                                        <div><span class="badge @VerdictBadge(a.Verdict)">@a.Verdict</span></div>
                                    }
                                }
                                else
                                {
                                    <span class="r-no-score">Chưa chấm</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @StatusBadge(a.Status)">@StatusText(a.Status)</span>
                                @if (a.InterviewAt.HasValue)
                                {
                                    <div class="text-muted small mt-1"><i class="bi bi-calendar-event"></i> @a.InterviewAt.Value.ToString("HH:mm dd/MM")</div>
                                }
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(a.ResumeFilePath))
                                {
                                    <a href="@a.ResumeFilePath" target="_blank" class="text-decoration-none">
                                        <i class="bi bi-file-earmark-pdf"></i> PDF
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-success"
                                        onclick="openInterview(@a.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.CandidateName))', '@(a.InterviewAt?.ToString("yyyy-MM-ddTHH:mm"))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.InterviewNote ?? ""))')">
                                    <i class="bi bi-calendar-plus"></i> Hẹn PV
                                </button>
                                <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Xem</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal hẹn phỏng vấn -->
<div class="modal fade" id="interviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <form asp-action="ScheduleInterview" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="ivAppId" />
                <input type="hidden" name="jobId" value="@Model.Job.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Hẹn phỏng vấn: <span id="ivName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Thời gian phỏng vấn <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="interviewAt" id="ivTime" required class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold">Địa điểm / Link / Ghi chú</label>
                        <input type="text" name="note" id="ivNote" maxlength="500" class="form-control"
                               placeholder="VD: Google Meet meet.google.com/... hoặc Tầng 5, tòa nhà ABC" />
                    </div>
                    <div class="text-muted small">
                        <i class="bi bi-envelope"></i> Hệ thống sẽ tự gửi email mời phỏng vấn tới ứng viên
                        (cần cấu hình email trong <strong>Hồ sơ cá nhân</strong>).
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Huỷ</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Lưu &amp; Gửi email</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ApplicantMatchModal")

@functions {
    string StatusBadge(Domain.Enums.ApplicationStatus s) => s switch
    {
        Domain.Enums.ApplicationStatus.Pending => "bg-secondary",
        Domain.Enums.ApplicationStatus.Reviewing => "bg-info text-dark",
        Domain.Enums.ApplicationStatus.EvaluatingAI => "bg-primary",
        Domain.Enums.ApplicationStatus.Interview => "bg-warning text-dark",
        Domain.Enums.ApplicationStatus.Accepted => "bg-success",
        Domain.Enums.ApplicationStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    string StatusText(Domain.Enums.ApplicationStatus s) => s switch
    {
        Domain.Enums.ApplicationStatus.Pending => "Chờ xem",
        Domain.Enums.ApplicationStatus.Reviewing => "Đang xem xét",
        Domain.Enums.ApplicationStatus.EvaluatingAI => "Đang chấm AI",
        Domain.Enums.ApplicationStatus.Interview => "Đã hẹn PV",
        Domain.Enums.ApplicationStatus.Accepted => "Đạt",
        Domain.Enums.ApplicationStatus.Rejected => "Từ chối",
        _ => s.ToString()
    };

    string ScoreClass(int score) => score switch
    {
        >= 70 => "r-score-hi",
        >= 50 => "r-score-md",
        _ => "r-score-lo"
    };

    string VerdictBadge(string? v) => v switch
    {
        not null when v.Contains("Rất phù hợp") => "bg-success",
        not null when v.StartsWith("Phù hợp") => "bg-primary",
        not null when v.Contains("Cân nhắc") => "bg-warning text-dark",
        _ => "bg-danger"
    };
}

@section Scripts {
    <script>
        function startScoring(rescore) {
            const rows = Array.from(document.querySelectorAll('tr[data-app-id]'));
            const targets = rows.filter(r => rescore || r.dataset.scored !== '1');
            if (!targets.length) {
                alert(rescore ? 'Không có ứng viên nào để chấm.' : 'Tất cả ứng viên đã được chấm.');
                return;
            }

            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenEl ? tokenEl.value : '';
            const panel = document.getElementById('scoreProgress');
            const bar = document.getElementById('scoreProgressBar');
            const label = document.getElementById('scoreProgressLabel');
            const count = document.getElementById('scoreProgressCount');
            const btnNew = document.getElementById('btnScoreNew');
            const btnAll = document.getElementById('btnScoreAll');

            panel.style.display = '';
            btnNew.disabled = true; btnAll.disabled = true;

            let done = 0, ok = 0, firstErr = null;

            (async function () {
                for (const row of targets) {
                    const id = row.dataset.appId;
                    const name = row.dataset.name || ('#' + id);
                    label.textContent = `Đang chấm ${done + 1}/${targets.length}: ${name}`;
                    count.textContent = `${done}/${targets.length}`;
                    bar.style.width = (done / targets.length * 100) + '%';

                    try {
                        const res = await fetch('/Application/ScoreOne/' + id, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token }
                        });
                        const d = await res.json();
                        if (d.ok) { ok++; updateScoreCell(id, d.score, d.verdict); row.dataset.scored = '1'; }
                        else if (!firstErr) firstErr = d.error;
                    } catch (e) {
                        if (!firstErr) firstErr = 'Lỗi kết nối máy chủ AI.';
                    }

                    done++;
                    count.textContent = `${done}/${targets.length}`;
                    bar.style.width = (done / targets.length * 100) + '%';
                }

                label.textContent = `Hoàn thành ${ok}/${targets.length}` + (firstErr ? ` · Lỗi: ${firstErr}` : '');
                btnNew.disabled = false; btnAll.disabled = false;
                // Tải lại để cập nhật đầy đủ các cột (Title / KN / Skills / Tóm tắt)
                setTimeout(() => location.reload(), 1500);
            })();
        }

        function updateScoreCell(id, score, verdict) {
            const cell = document.getElementById('score-' + id);
            if (!cell) return;
            const cls = score >= 70 ? 'r-score-hi' : score >= 50 ? 'r-score-md' : 'r-score-lo';
            const v = verdict || '';
            const vcls = /Rất phù hợp/.test(v) ? 'bg-success'
                : /^Phù hợp/.test(v) ? 'bg-primary'
                : /Cân nhắc/.test(v) ? 'bg-warning text-dark' : 'bg-danger';
            cell.innerHTML = `<span class="r-score ${cls}">${score}<span class="unit">/100</span></span>`
                + (v ? `<div><span class="badge ${vcls}">${v}</span></div>` : '');
        }

        function openInterview(appId, name, time, note) {
            document.getElementById('ivAppId').value = appId;
            document.getElementById('ivName').textContent = name;
            document.getElementById('ivTime').value = time || '';
            document.getElementById('ivNote').value = note || '';
            new bootstrap.Modal(document.getElementById('interviewModal')).show();
        }
    </script>
}
