@model WebApp.Models.Application.JobApplicantsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Ứng viên: " + Model.Job.Title;
    var total = Model.Applicants.Count();
    var graded = Model.Applicants.Count(a => a.AiMatchScore.HasValue);
    var avgScore = graded > 0
        ? Model.Applicants.Where(a => a.AiMatchScore.HasValue).Average(a => a.AiMatchScore!.Value)
        : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Ứng viên ứng tuyển</h3>
        <div class="text-muted">@Model.Job.Title</div>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="Analyze" asp-route-id="@Model.Job.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-stars me-1"></i> Phân tích CV bằng AI
            </button>
        </form>
        <a asp-controller="JobPosting" asp-action="Details" asp-route-id="@Model.Job.Id"
           class="btn btn-outline-secondary btn-sm">← Quay lại tin</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Thống kê -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body">
                <div class="display-6 fw-bold">@total</div>
                <div class="text-muted small">Tổng đơn</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body">
                <div class="display-6 fw-bold text-primary">@graded</div>
                <div class="text-muted small">Đã chấm AI</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body">
                <div class="display-6 fw-bold">@(graded > 0 ? avgScore.ToString("0") : "—")</div>
                <div class="text-muted small">Điểm AI trung bình</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body">
                <div class="display-6 fw-bold text-secondary">@(total - graded)</div>
                <div class="text-muted small">Chưa chấm</div>
            </div>
        </div>
    </div>
</div>

<div class="text-muted small mb-2">Hiển thị @total ứng viên</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tên</th>
                    <th>Title</th>
                    <th class="text-center">KN tổng</th>
                    <th>Loại</th>
                    <th>Skills</th>
                    <th>Tóm tắt</th>
                    <th class="text-center">Điểm AI</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">File</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Applicants.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-5">
                            Chưa có ứng viên nào nộp hồ sơ cho tin tuyển dụng này.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var a in Model.Applicants)
                    {
                        var initial = string.IsNullOrWhiteSpace(a.CandidateName) ? "?" : a.CandidateName.Trim()[..1].ToUpper();
                        var loai = a.IsFresher == true ? "Fresher" : (a.TotalYears.HasValue ? $"{a.TotalYears.Value:0.#}y+" : "—");
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="r-avatar">@initial</div>
                                    <div>
                                        <a role="button" class="text-decoration-none fw-semibold"
                                           onclick="openCvDetail(this)"
                                           data-name="@a.CandidateName"
                                           data-email="@a.CandidateEmail"
                                           data-title="@a.CvTitle"
                                           data-total="@(a.TotalYears.HasValue ? a.TotalYears.Value.ToString("0.#") + "y" : "—")"
                                           data-ai="@(a.AiYears.HasValue ? a.AiYears.Value.ToString("0.#") + "y" : "—")"
                                           data-type="@loai"
                                           data-summary="@a.Summary"
                                           data-skills="@JsonSerializer.Serialize(a.Skills)"
                                           data-strengths="@JsonSerializer.Serialize(a.Strengths)"
                                           data-weaknesses="@JsonSerializer.Serialize(a.Weaknesses)"
                                           data-pdf="@a.ResumeFilePath">
                                            @a.CandidateName
                                        </a>
                                        <div class="text-muted small">@a.CandidateEmail</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(a.CvTitle) ? "—" : a.CvTitle)</td>
                            <td class="text-center">@(a.TotalYears.HasValue ? a.TotalYears.Value.ToString("0.#") + "y" : "—")</td>
                            <td>
                                @if (a.IsFresher == true)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis">Fresher</span>
                                }
                                else if (a.TotalYears.HasValue)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">@a.TotalYears.Value.ToString("0.#")y+</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td style="max-width: 220px;">
                                @if (a.Skills.Any())
                                {
                                    foreach (var skill in a.Skills.Take(6))
                                    {
                                        <span class="badge rounded-pill bg-light text-dark border me-1 mb-1">@skill</span>
                                    }
                                    @if (a.Skills.Count > 6)
                                    {
                                        <span class="text-muted small">+@(a.Skills.Count - 6)</span>
                                    }
                                }
                                else
                                {
                                    <span class="r-no-score">Chưa phân tích</span>
                                }
                            </td>
                            <td style="max-width: 260px;">
                                @if (!string.IsNullOrWhiteSpace(a.Summary))
                                {
                                    <div class="r-clamp2">@a.Summary</div>
                                }
                                else
                                {
                                    <span class="r-no-score">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (a.AiMatchScore.HasValue)
                                {
                                    <span class="r-score @ScoreClass(a.AiMatchScore.Value)">
                                        @a.AiMatchScore<span class="unit">/100</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="r-no-score">Chưa chấm</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @StatusBadge(a.Status)">@StatusText(a.Status)</span>
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(a.ResumeFilePath))
                                {
                                    <a href="@a.ResumeFilePath" target="_blank" class="text-decoration-none">
                                        <i class="bi bi-file-earmark-pdf"></i> PDF
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Xem hồ sơ</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_CvDetailModal")

@functions {
    string StatusBadge(Domain.Enums.ApplicationStatus s) => s switch
    {
        Domain.Enums.ApplicationStatus.Pending => "bg-secondary",
        Domain.Enums.ApplicationStatus.Reviewing => "bg-info text-dark",
        Domain.Enums.ApplicationStatus.EvaluatingAI => "bg-primary",
        Domain.Enums.ApplicationStatus.Accepted => "bg-success",
        Domain.Enums.ApplicationStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    string StatusText(Domain.Enums.ApplicationStatus s) => s switch
    {
        Domain.Enums.ApplicationStatus.Pending => "Chờ xem",
        Domain.Enums.ApplicationStatus.Reviewing => "Đang xem xét",
        Domain.Enums.ApplicationStatus.EvaluatingAI => "Đang chấm AI",
        Domain.Enums.ApplicationStatus.Accepted => "Đạt",
        Domain.Enums.ApplicationStatus.Rejected => "Từ chối",
        _ => s.ToString()
    };

    string ScoreClass(int score) => score switch
    {
        >= 70 => "r-score-hi",
        >= 50 => "r-score-md",
        _ => "r-score-lo"
    };
}
