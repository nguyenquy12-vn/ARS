@model IEnumerable<Services.DTOs.User.UserDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Người dùng";
}

<style>
    .user-page-header { display:flex; justify-content:space-between; align-items:end; gap:1rem; margin-bottom:1.5rem; }
    .user-page-kicker { color:#3b82f6; font-size:.75rem; font-weight:800; letter-spacing:.09em; text-transform:uppercase; }
    .user-page-header h3 { color:#0f172a; letter-spacing:-.035em; }
    .user-filter-card,.user-table-card { border:1px solid #e8edf4 !important; border-radius:16px; box-shadow:0 8px 26px rgba(15,23,42,.045) !important; overflow:hidden; }
    .user-filter-card .card-body { padding:1.1rem 1.25rem; background:linear-gradient(115deg,#fff 0%,#f8fbff 100%); }
    .user-filter-label { display:block; margin-bottom:.35rem; color:#64748b; font-size:.73rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase; }
    .user-filter-card .form-control,.user-filter-card .form-select,.user-filter-card .input-group-text { min-height:44px; border-color:#dbe5ef; background:#fff; }
    .user-filter-card .form-control:focus,.user-filter-card .form-select:focus { border-color:#60a5fa; box-shadow:0 0 0 .2rem rgba(59,130,246,.12); }
    .user-filter-card .input-group-text { color:#5790bd; border-right:0; }.user-filter-card .form-control { border-left:0; }
    .user-filter-count { display:inline-flex; align-items:center; gap:.35rem; padding:.38rem .7rem; border-radius:999px; color:#2563eb; background:#eff6ff; font-size:.8rem; font-weight:700; }
    .user-table-card .table { margin:0; }.user-table-card thead th { padding:1rem .8rem; border-bottom:1px solid #dce5ee; color:#526b80; background:#f8fafc; font-size:.72rem; font-weight:800; letter-spacing:.055em; text-transform:uppercase; white-space:nowrap; }
    .user-table-card tbody td { padding:1rem .8rem; border-color:#edf1f5; vertical-align:middle; }.user-table-card tbody tr { transition:background .18s ease; }.user-table-card tbody tr:hover { background:#f8fbff; }
    .avatar-circle { width:38px !important; height:38px !important; border:1px solid #bfdbfe; background:#eff6ff !important; }.user-role-badge,.user-status-badge { border-radius:999px; font-size:.75rem; font-weight:700; padding:.38rem .65rem !important; }
    .user-action-cell .btn { border-radius:8px; }.role-promote-form { min-width:205px; }.role-promote-form .form-select { font-size:.75rem; }
    @@media (max-width: 767.98px) { .user-page-header { align-items:start; flex-direction:column; }.user-table-card tbody td { min-width:130px; }.role-promote-form { min-width:185px; } }
</style>

<div class="user-page-header">
    <div>
        <div class="user-page-kicker"><i class="bi bi-people-fill me-1"></i>Quản trị hệ thống</div>
        <h3 class="fw-bold mb-1">Quản lý Người dùng</h3>
        <p class="text-muted mb-0">Quản lý danh sách tài khoản, phân quyền và trạng thái hoạt động trong hệ thống.</p>
    </div>
    <span class="user-filter-count"><i class="bi bi-person-check-fill"></i><span id="visibleUserCount">@(Model?.Count() ?? 0)</span> tài khoản</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- Thẻ Tìm kiếm & Lọc -->
<div class="card border-0 shadow-sm mb-4 user-filter-card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="searchInput" class="user-filter-label">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Tìm kiếm theo tên, email...">
                </div>
            </div>
            <div class="col-md-3">
                <label for="roleFilter" class="user-filter-label">Vai trò</label>
                <select id="roleFilter" class="form-select">
                    <option value="">-- Tất cả Vai trò --</option>
                    <option value="Admin">Admin</option>
                    <option value="Recruiter">Recruiter (Nhà tuyển dụng)</option>
                    <option value="Candidate">Candidate (Ứng viên)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="statusFilter" class="user-filter-label">Trạng thái</label>
                <select id="statusFilter" class="form-select">
                    <option value="">-- Tất cả Trạng thái --</option>
                    <option value="Active">Active (Hoạt động)</option>
                    <option value="Locked">Locked (Đã khóa)</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Bảng Danh sách Người dùng -->
<div class="card border-0 shadow-sm user-table-card ui-data-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="userTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Họ và Tên</th>
                        <th>Email / Số điện thoại</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            var initialChar = !string.IsNullOrEmpty(user.FullName) ? user.FullName.Trim().Substring(0, 1).ToUpper() : "U";

                            <tr data-role="@user.RoleName" data-status="@user.Status">
                                <td class="ps-4 fw-semibold text-secondary">#@user.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-primary-subtle text-primary fw-bold me-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            @initialChar
                                        </div>
                                        <span class="fw-medium text-dark">@(user.FullName ?? "Chưa cập nhật")</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-dark">@user.Email</div>
                                    <small class="text-muted">@(string.IsNullOrEmpty(user.PhoneNumber) ? "Chưa cập nhật" : user.PhoneNumber)</small>
                                </td>
                                <td>
                                    @if (string.Equals(user.RoleName, "Admin", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge user-role-badge bg-danger-subtle text-danger border border-danger-subtle">@user.DisplayedRoleName</span>
                                    }
                                    else if (string.Equals(user.RoleName, "Recruiter", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge user-role-badge bg-primary-subtle text-primary border border-primary-subtle">@user.DisplayedRoleName</span>
                                    }
                                    else
                                    {
                                        <span class="badge user-role-badge bg-info-subtle text-info border border-info-subtle">@user.DisplayedRoleName</span>
                                    }
                                </td>
                                <td>
                                    @if (string.Equals(user.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge user-status-badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge user-status-badge bg-secondary-subtle text-secondary">
                                            <i class="bi bi-slash-circle-fill me-1"></i> Đã khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-muted fs-7">
                                    @user.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end pe-4 user-action-cell">
                                    <div class="btn-group">
                                        <!-- 1. Xem chi tiết (Đã khớp asp-route-userId) -->
                                        <a asp-action="Details" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-secondary" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (string.Equals(user.RoleName, "Candidate", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form asp-action="PromoteCandidate" method="post" class="d-flex ms-1 role-promote-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <select name="targetRole" class="form-select form-select-sm" style="width: 155px;" aria-label="Nâng quyền">
                                                    <option value="Recruiter">Nâng lên Recruiter</option>
                                                    <option value="Admin">Nâng lên Admin</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-primary ms-1" title="Xác nhận nâng quyền">
                                                    <i class="bi bi-arrow-up-circle"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- 2. Nút Khóa / Mở khóa (Ẩn nếu tài khoản là Admin) -->
                                        @if (!string.Equals(user.RoleName, "Admin", StringComparison.OrdinalIgnoreCase))
                                        {
                                            if (string.Equals(user.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#confirmModal"
                                                        data-user-id="@user.Id"
                                                        data-user-name="@user.FullName"
                                                        data-action-type="Lock">
                                                    <i class="bi bi-lock-fill"></i> Khóa
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#confirmModal"
                                                        data-user-id="@user.Id"
                                                        data-user-name="@user.FullName"
                                                        data-action-type="Unlock">
                                                    <i class="bi bi-unlock-fill"></i> Mở khóa
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy người dùng nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== MODAL XÁC NHẬN KHÓA / MỞ KHÓA ==================== -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" id="modalHeader">
                <h5 class="modal-title fw-bold" id="confirmModalLabel">Xác nhận hành động</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div id="modalIcon" class="mb-3"></div>
                <p class="fs-6 mb-1" id="modalMessage">Bạn có chắc chắn muốn thực hiện thao tác này?</p>
                <small class="text-muted" id="modalSubMessage">Hành động này có thể ảnh hưởng đến quyền truy cập của người dùng.</small>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>

                <form id="actionForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" id="modalUserId" value="" />
                    <button type="submit" class="btn" id="modalSubmitBtn">Xác nhận</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // 1. Sự kiện mở Modal Xác nhận Khóa/Mở khóa
            $('#confirmModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var userId = button.data('user-id');
                var userName = button.data('user-name') || 'người dùng này';
                var actionType = button.data('action-type');

                $('#modalUserId').val(userId);

                if (actionType === 'Lock') {
                    $('#modalHeader').removeClass('bg-success').addClass('bg-danger');
                    $('#modalIcon').html('<i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>');
                    $('#modalMessage').html('Bạn có chắc chắn muốn <strong>KHÓA</strong> tài khoản của <strong>' + userName + '</strong>?');
                    $('#modalSubMessage').text('Người dùng này sẽ không thể đăng nhập vào hệ thống sau khi bị khóa.');

                    $('#actionForm').attr('action', '/admin/users/lock');
                    $('#modalSubmitBtn').removeClass('btn-success').addClass('btn-danger').text('Khóa tài khoản');
                } else {
                    $('#modalHeader').removeClass('bg-danger').addClass('bg-success');
                    $('#modalIcon').html('<i class="bi bi-check-circle-fill text-success display-4"></i>');
                    $('#modalMessage').html('Bạn có chắc chắn muốn <strong>MỞ KHÓA</strong> tài khoản cho <strong>' + userName + '</strong>?');
                    $('#modalSubMessage').text('Người dùng sẽ có thể đăng nhập lại vào hệ thống bình thường.');

                    $('#actionForm').attr('action', '/admin/users/unlock');
                    $('#modalSubmitBtn').removeClass('btn-danger').addClass('btn-success').text('Mở khóa tài khoản');
                }
            });

            // 2. Bộ lọc Client-side (Từ khóa, Role, Trạng thái)
            function filterUsers() {
                var searchVal = $("#searchInput").val().toLowerCase().trim();
                var selectedRole = $("#roleFilter").val().toLowerCase().trim();
                var selectedStatus = $("#statusFilter").val().toLowerCase().trim();

                $("#userTable tbody tr").each(function () {
                    var row = $(this);

                    // Bỏ qua dòng thông báo "Không tìm thấy người dùng" nếu có
                    if (row.find('td').length === 1) return;

                    var textContent = row.text().toLowerCase();
                    var userRole = (row.data("role") || "").toString().toLowerCase();
                    var userStatus = (row.data("status") || "").toString().toLowerCase();

                    var matchesSearch = searchVal === "" || textContent.indexOf(searchVal) > -1;
                    var matchesRole = selectedRole === "" || userRole === selectedRole;
                    var matchesStatus = selectedStatus === "" || userStatus === selectedStatus;

                    if (matchesSearch && matchesRole && matchesStatus) {
                        row.show();
                    } else {
                        row.hide();
                    }
                });

                $('#visibleUserCount').text($('#userTable tbody tr:visible').filter(function () {
                    return $(this).find('td').length > 1;
                }).length);
            }

            $("#searchInput").on("keyup search", filterUsers);
            $("#roleFilter, #statusFilter").on("change", filterUsers);
        });
    </script>
}
