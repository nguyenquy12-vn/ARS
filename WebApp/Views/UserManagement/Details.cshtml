@model WebApp.Models.Admin.UserDetailsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Chi tiết người dùng</h3>
        <p class="text-muted mb-0">Xem thông tin tài khoản và dữ liệu liên quan trong hệ thống.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>

@if (Model?.User == null)
{
    <div class="alert alert-warning border-0 shadow-sm text-center py-4">
        <i class="bi bi-exclamation-triangle-fill fs-2 d-block mb-2 text-warning"></i>
        Không tìm thấy thông tin người dùng yêu cầu.
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="avatar-circle bg-primary-subtle text-primary fw-bold mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px; font-size: 32px;">
                        @(!string.IsNullOrWhiteSpace(Model.User.FullName) ? Model.User.FullName.Trim().Substring(0, 1).ToUpper() : "U")
                    </div>

                    <h4 class="fw-bold mb-1">@Model.User.FullName</h4>
                    <p class="text-muted mb-3">#@Model.User.Id</p>

                    <div class="d-flex justify-content-center gap-2 mb-4">
                        @if (string.Equals(Model.User.RoleName, "Admin", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">@Model.User.DisplayedRoleName</span>
                        }
                        else if (string.Equals(Model.User.RoleName, "Recruiter", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">@Model.User.DisplayedRoleName</span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2">@Model.User.DisplayedRoleName</span>
                        }

                        @if (string.Equals(Model.User.Status, "Active", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-success-subtle text-success px-3 py-2">
                                <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary px-3 py-2">
                                <i class="bi bi-slash-circle-fill me-1"></i> Đã khóa
                            </span>
                        }
                    </div>

                    <hr class="my-3" />

                    <div class="text-start">
                        <div class="mb-3">
                            <label class="text-muted fs-7 d-block mb-1">Địa chỉ email</label>
                            <span class="fw-medium text-dark"><i class="bi bi-envelope me-2 text-muted"></i>@Model.User.Email</span>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted fs-7 d-block mb-1">Số điện thoại</label>
                            <span class="fw-medium text-dark">
                                <i class="bi bi-telephone me-2 text-muted"></i>
                                @(string.IsNullOrEmpty(Model.User.PhoneNumber) ? "Chưa cập nhật" : Model.User.PhoneNumber)
                            </span>
                        </div>

                        <div>
                            <label class="text-muted fs-7 d-block mb-1">Ngày tham gia</label>
                            <span class="fw-medium text-dark"><i class="bi bi-calendar3 me-2 text-muted"></i>@Model.User.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            @if (string.Equals(Model.User.RoleName, "Candidate", StringComparison.OrdinalIgnoreCase))
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-file-earmark-person me-2"></i>CV và lịch sử ứng tuyển (@(Model.Resumes?.Count ?? 0))
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Resumes != null && Model.Resumes.Any())
                        {
                            <div class="accordion" id="resumeAccordion">
                                @foreach (var resume in Model.Resumes)
                                {
                                    var resumeCollapseId = $"collapseResume_{resume.Id}";
                                    var resumeHeaderId = $"headingResume_{resume.Id}";

                                    <div class="accordion-item border rounded mb-3 overflow-hidden shadow-sm">
                                        <h2 class="accordion-header" id="@resumeHeaderId">
                                            <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#@resumeCollapseId" aria-expanded="false" aria-controls="@resumeCollapseId">
                                                <div class="d-flex align-items-center justify-content-between w-100 me-3">
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi bi-file-earmark-pdf fs-4 text-danger me-2"></i>
                                                        <span class="fw-bold text-dark">@resume.Title</span>
                                                        @if (resume.IsDefault)
                                                        {
                                                            <span class="badge bg-warning text-dark ms-2"><i class="bi bi-star-fill me-1"></i>Mặc định</span>
                                                        }
                                                    </div>
                                                    <small class="text-muted">Tạo: @resume.CreatedAt.ToString("dd/MM/yyyy")</small>
                                                </div>
                                            </button>
                                        </h2>

                                        <div id="@resumeCollapseId" class="accordion-collapse collapse" aria-labelledby="@resumeHeaderId" data-bs-parent="#resumeAccordion">
                                            <div class="accordion-body bg-white">
                                                <div class="d-flex justify-content-between align-items-center p-2 mb-3 bg-light rounded border">
                                                    <small class="text-muted"><i class="bi bi-paperclip me-1"></i>File: @resume.FilePath</small>
                                                    <a href="@resume.FilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-box-arrow-up-right me-1"></i> Xem CV
                                                    </a>
                                                </div>

                                                <h6 class="fw-bold text-secondary mb-2 fs-7 text-uppercase">
                                                    <i class="bi bi-send me-1"></i>Công việc đã ứng tuyển bằng CV này (@(resume.Applications?.Count ?? 0))
                                                </h6>

                                                @if (resume.Applications != null && resume.Applications.Any())
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-hover align-middle mb-0 fs-7 border">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>ID</th>
                                                                    <th>Bài đăng tuyển</th>
                                                                    <th>Ngày ứng tuyển</th>
                                                                    <th>Trạng thái</th>
                                                                    <th class="text-end">Thao tác</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var app in resume.Applications)
                                                                {
                                                                    <tr>
                                                                        <td class="fw-bold text-secondary">#@app.Id</td>
                                                                        <td>@app.JobTitle</td>
                                                                        <td class="text-muted">@app.AppliedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                                        <td><span class="badge bg-info-subtle text-info border border-info-subtle">@app.Status</span></td>
                                                                        <td class="text-end">
                                                                            <a asp-controller="JobManagement" asp-action="Details" asp-route-jobId="@app.JobPostingId" class="btn btn-sm btn-light border" title="Xem tin tuyển dụng">
                                                                                <i class="bi bi-eye"></i>
                                                                            </a>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <p class="text-muted fs-7 mb-0 py-2">CV này chưa được sử dụng để ứng tuyển công việc nào.</p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-folder-x fs-2 d-block mb-2"></i>
                                Ứng viên này chưa tải lên CV nào.
                            </div>
                        }
                    </div>
                </div>
            }
            else if (string.Equals(Model.User.RoleName, "Recruiter", StringComparison.OrdinalIgnoreCase))
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-building me-2"></i>Thông tin công ty</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.CompanyProfile != null && Model.CompanyProfile.Id > 0)
                        {
                            <div class="d-flex align-items-start gap-3 mb-4">
                                <div class="border rounded p-2 bg-light d-flex align-items-center justify-content-center" style="width: 90px; height: 90px; flex-shrink: 0;">
                                    @if (!string.IsNullOrEmpty(Model.CompanyProfile.LogoPath))
                                    {
                                        <img src="@Model.CompanyProfile.LogoPath" alt="Company Logo" class="img-fluid max-h-100" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-building-gear fs-1 text-secondary"></i>
                                    }
                                </div>

                                <div>
                                    <h4 class="fw-bold text-dark mb-1">@Model.CompanyProfile.CompanyName</h4>
                                    <p class="text-muted mb-1 fs-7">
                                        <i class="bi bi-receipt me-1"></i> Mã số thuế: <strong>@Model.CompanyProfile.TaxCode</strong>
                                    </p>
                                    @if (!string.IsNullOrEmpty(Model.CompanyProfile.Website))
                                    {
                                        <a href="@Model.CompanyProfile.Website" target="_blank" class="fs-7 text-primary text-decoration-none">
                                            <i class="bi bi-globe me-1"></i>@Model.CompanyProfile.Website
                                        </a>
                                    }
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded border">
                                        <label class="text-muted fs-7 d-block mb-1">Quy mô công ty</label>
                                        <span class="fw-medium text-dark"><i class="bi bi-people me-2 text-primary"></i>@(Model.CompanyProfile.CompanySize ?? "Chưa cập nhật")</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded border">
                                        <label class="text-muted fs-7 d-block mb-1">Địa chỉ trụ sở</label>
                                        <span class="fw-medium text-dark"><i class="bi bi-geo-alt me-2 text-primary"></i>@(Model.CompanyProfile.Address ?? "Chưa cập nhật")</span>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="fw-bold text-secondary mb-2 fs-7">Giới thiệu về công ty</label>
                                <div class="p-3 bg-light rounded border text-muted fs-7">
                                    @(string.IsNullOrEmpty(Model.CompanyProfile.Overview) ? "Chưa có mô tả tổng quan." : Model.CompanyProfile.Overview)
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-building-exclamation fs-2 d-block mb-2"></i>
                                Nhà tuyển dụng này chưa khởi tạo thông tin công ty.
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm p-4 text-center text-muted">
                    <i class="bi bi-shield-check fs-1 text-danger mb-2"></i>
                    <p class="mb-0 fw-medium">Đây là tài khoản quản trị viên của hệ thống.</p>
                </div>
            }
        </div>
    </div>
}
