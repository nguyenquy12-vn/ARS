@model WebApp.Models.Company.CompanyFormViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Tạo hồ sơ công ty" : "Chỉnh sửa hồ sơ công ty";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">@ViewData["Title"]</h3>
        @if (!isNew)
        {
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Quay lại</a>
        }
    </div>

    @if (isNew)
    {
        <div class="alert alert-info">
            Bạn cần hoàn tất hồ sơ công ty trước khi có thể đăng tin tuyển dụng.
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                        <input asp-for="CompanyName" class="form-control" placeholder="Ví dụ: FPT Software" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="TaxCode" class="form-label fw-semibold"></label>
                        <input asp-for="TaxCode" class="form-control" placeholder="Ví dụ: 0101248141" />
                        <span asp-validation-for="TaxCode" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CompanySize" class="form-label fw-semibold"></label>
                        <input asp-for="CompanySize" class="form-control" placeholder="Ví dụ: 100-500 nhân viên" />
                        <span asp-validation-for="CompanySize" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Website" class="form-label fw-semibold"></label>
                        <input asp-for="Website" class="form-control" placeholder="https://congty.com" />
                        <span asp-validation-for="Website" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold"></label>
                    <input asp-for="Address" class="form-control" placeholder="Số nhà, đường, quận, thành phố" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LogoPath" class="form-label fw-semibold"></label>
                    <input asp-for="LogoPath" class="form-control" placeholder="/uploads/logos/logo.png" />
                    <span asp-validation-for="LogoPath" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Overview" class="form-label fw-semibold"></label>
                    <textarea asp-for="Overview" class="form-control" rows="5"
                              placeholder="Giới thiệu ngắn về công ty, lĩnh vực hoạt động, văn hóa..."></textarea>
                    <span asp-validation-for="Overview" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary fw-semibold">Lưu hồ sơ</button>
                    @if (!isNew)
                    {
                        <a asp-action="Index" class="btn btn-light">Hủy</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
