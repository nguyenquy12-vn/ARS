@model (bool IsSuccessful, string Message)
@{ Layout = "_RecruiterLayout"; ViewData["Title"] = "Kết quả VNPay"; }
<div class="row justify-content-center"><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body p-5 text-center"><div class="display-5 @(Model.IsSuccessful ? "text-success" : "text-danger")"><i class="bi @(Model.IsSuccessful ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i></div><h2 class="fw-bold mt-3">@(Model.IsSuccessful ? "Thanh toán VNPay thành công" : "Giao dịch chưa thành công")</h2><p class="text-muted">@Model.Message</p>@if (Model.IsSuccessful) { <div class="alert alert-success text-start"><i class="bi bi-lightning-charge-fill me-2"></i>Gói dịch vụ đã được kích hoạt tự động.</div> }<a asp-controller="Billing" asp-action="Index" class="btn btn-primary">Về gói & thanh toán</a></div></div></div></div>
