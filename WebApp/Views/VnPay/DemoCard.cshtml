@model Domain.Entities.PaymentOrder
@{ Layout = "_RecruiterLayout"; ViewData["Title"] = "Thanh toán thẻ Demo"; }
<div class="row justify-content-center"><div class="col-lg-7"><a asp-controller="Billing" asp-action="Checkout" asp-route-id="@Model.Id" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Quay lại thanh toán</a><div class="card border-0 shadow-sm mt-3"><div class="card-body p-4 p-md-5"><div class="text-center"><div class="text-primary fs-2"><i class="bi bi-credit-card-2-front-fill"></i></div><h2 class="fw-bold">Thanh toán thẻ Demo</h2><p class="text-muted">VNPay Sandbox · @Model.Amount.ToString("N0")đ · Không lưu thông tin thẻ</p></div><form asp-action="SubmitDemoCard" method="post" class="mt-4">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@Model.Id" /><div class="mb-3"><label class="form-label fw-semibold">Số thẻ</label><input class="form-control" name="cardNumber" inputmode="numeric" placeholder="9704 1985 2619 1432 198" required /></div><div class="mb-3"><label class="form-label fw-semibold">Tên chủ thẻ</label><input class="form-control text-uppercase" name="cardHolder" placeholder="NGUYEN VAN A" required /></div><div class="row"><div class="col-md-6 mb-3"><label class="form-label fw-semibold">Ngày phát hành</label><input class="form-control" name="issueDate" placeholder="07/15" required /></div><div class="col-md-6 mb-3"><label class="form-label fw-semibold">OTP</label><input class="form-control" name="otp" inputmode="numeric" placeholder="123456" required /></div></div><button type="submit" class="btn btn-primary w-100 fw-bold py-2">Xác nhận thanh toán Demo</button></form><div class="alert alert-light border small mt-4 mb-0"><strong>Thẻ test thành công:</strong> NCB <code>9704198526191432198</code> · NGUYEN VAN A · 07/15 · OTP 123456.</div></div></div></div></div>
