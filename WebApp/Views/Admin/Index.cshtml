@using Domain.Entities
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Tổng quan"; var apps = ViewBag.RecentApplications as List<Application> ?? new(); var users = ViewBag.RecentUsers as List<User> ?? new(); }
<style>.admin-heading h1{font-weight:800;letter-spacing:-.04em}.kpi{height:100%;padding:1.35rem;border:1px solid #e4eaf2;border-radius:16px;background:#fff;box-shadow:0 7px 20px #17375e0a}.kpi i{display:grid;width:42px;height:42px;place-items:center;border-radius:12px;color:#1769e8;background:#eaf3ff;font-size:1.1rem}.kpi strong{display:block;margin-top:1rem;font-size:1.65rem}.kpi span{color:#7b899d;font-size:.78rem}.admin-panel{border:1px solid #e4eaf2;border-radius:16px;background:#fff;overflow:hidden}.panel-head{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 1.35rem;border-bottom:1px solid #edf1f5;font-weight:800}.panel-head a{color:#1769e8;font-size:.72rem;font-weight:700;text-decoration:none}.activity{display:flex;gap:.8rem;padding:1rem 1.35rem;border-bottom:1px solid #f0f3f7}.activity:last-child{border:0}.activity-icon{display:grid;flex:0 0 38px;height:38px;place-items:center;border-radius:11px;color:#1267d9;background:#edf4ff}.activity small{display:block;color:#8794a7}.new-user{display:flex;align-items:center;gap:.75rem;padding:1rem 1.2rem;border-bottom:1px solid #edf1f5}.new-user:last-child{border:0}.user-avatar{display:grid;flex:0 0 42px;height:42px;place-items:center;border-radius:13px;color:#1769e8;background:#eaf3ff;font-size:.75rem;font-weight:800}.user-info{min-width:0;flex:1}.user-info strong,.user-info small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.user-info strong{font-size:.82rem}.user-info small{color:#8391a5;font-size:.68rem}.role-pill{padding:.25rem .5rem;border-radius:99px;color:#6550bb;background:#f0ecff;font-size:.62rem;font-weight:800}</style>
<div class="admin-heading mb-4"><span class="text-primary fw-bold small">ARS ADMIN</span><h1 class="mt-1 mb-1">Tổng quan hệ thống</h1><p class="text-muted mb-0">Theo dõi nhanh hoạt động và dữ liệu quan trọng trong hệ thống.</p></div>
<div class="row g-3 mb-4">
 <div class="col-md-6 col-xl-3"><div class="kpi"><i class="bi bi-people"></i><strong>@ViewBag.TotalUsers</strong><span>Người dùng · @ViewBag.Candidates ứng viên</span></div></div>
 <div class="col-md-6 col-xl-3"><div class="kpi"><i class="bi bi-briefcase"></i><strong>@ViewBag.ActiveJobs</strong><span>Tin tuyển dụng đang hoạt động</span></div></div>
 <div class="col-md-6 col-xl-3"><div class="kpi"><i class="bi bi-file-earmark-person"></i><strong>@ViewBag.Applications</strong><span>Đơn ứng tuyển · +@ViewBag.TodayApplications hôm nay</span></div></div>
 <div class="col-md-6 col-xl-3"><div class="kpi"><i class="bi bi-wallet2"></i><strong>@(((decimal)ViewBag.Revenue).ToString("N0"))đ</strong><span>Doanh thu · @ViewBag.PendingPayments đơn chờ duyệt</span></div></div>
</div>
<div class="row g-4"><div class="col-xl-8"><section class="admin-panel"><div class="panel-head"><span>Đơn ứng tuyển gần đây</span><a asp-controller="ApplicationManagement" asp-action="Index">Xem tất cả <i class="bi bi-arrow-right"></i></a></div>@foreach(var a in apps){<div class="activity"><div class="activity-icon"><i class="bi bi-send"></i></div><div><strong>@a.Candidate?.FullName</strong> ứng tuyển <strong>@a.JobPosting?.Title</strong><small>@a.AppliedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @a.Status</small></div></div>}@if(!apps.Any()){<div class="p-5 text-center text-muted">Chưa có đơn ứng tuyển.</div>}</section></div><div class="col-xl-4"><section class="admin-panel"><div class="panel-head"><span>Người dùng mới</span><a asp-controller="UserManagement" asp-action="Index">Xem tất cả <i class="bi bi-arrow-right"></i></a></div>@foreach(var user in users){var initials=string.Concat(user.FullName.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>x[0]));<div class="new-user"><div class="user-avatar">@initials</div><div class="user-info"><strong>@user.FullName</strong><small>@user.Email · @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></div><span class="role-pill">@(user.Role?.DisplayedName ?? "—")</span></div>}@if(!users.Any()){<div class="p-5 text-center text-muted">Chưa có người dùng mới.</div>}</section></div></div>
