@model WebApp.Models.Admin.AuditListViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Audit Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold">Audit Logs</h3>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Export" asp-route-actionFilter="@Model.ActionFilter" asp-route-actorEmail="@Model.ActorEmailFilter" asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">Export Filtered</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <input name="actionFilter" value="@Model.ActionFilter" class="form-control" placeholder="Action" />
            </div>
            <div class="col-md-3">
                <input name="actorEmail" value="@Model.ActorEmailFilter" class="form-control" placeholder="Actor email" />
            </div>
            <div class="col-md-2">
                <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? string.Empty)" class="form-control" />
            </div>
            <div class="col-md-2">
                <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? string.Empty)" class="form-control" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px" class="text-center"><input id="selectAll" type="checkbox" /></th>
                        <th>Time</th>
                        <th>Actor</th>
                        <th>Action</th>
                        <th>Target</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var it in Model.Items)
                        {
                            <tr>
                                <td class="text-center"><input type="checkbox" class="selectRow" value="@it.Id" /></td>
                                <td class="text-muted">@it.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@it.ActorEmail</td>
                                <td>@it.Action</td>
                                <td>@(string.IsNullOrEmpty(it.TargetType) ? "" : it.TargetType + ":" + (it.TargetId?.ToString() ?? ""))</td>
                                <td>@it.Description</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No audit logs.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 d-flex justify-content-between align-items-center">
    <div>
        <button id="exportSelected" class="btn btn-outline-secondary btn-sm">Export Selected</button>
    </div>
    <div>
        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        var cls = p == Model.Page ? "page-item active" : "page-item";
                        <li class="@cls"><a class="page-link" href="@Url.Action("Index", new { actionFilter = Model.ActionFilter, actorEmail = Model.ActorEmailFilter, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), page = p, pageSize = Model.PageSize })">@p</a></li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<form id="exportForm" method="get" asp-action="Export" style="display:none">
    <div id="exportIds"></div>
</form>

<script>
    (function(){
        const selectAll = document.getElementById('selectAll');
        const rowChecks = document.querySelectorAll('.selectRow');
        selectAll?.addEventListener('change', function(e){
            document.querySelectorAll('.selectRow').forEach(c => c.checked = e.target.checked);
        });

        document.getElementById('exportSelected')?.addEventListener('click', function(){
            const ids = Array.from(document.querySelectorAll('.selectRow:checked')).map(i => i.value);
            if(ids.length === 0){ alert('Please select at least one log'); return; }
            const container = document.getElementById('exportIds');
            container.innerHTML = '';
            ids.forEach(id => {
                const input = document.createElement('input');
                input.type = 'hidden'; input.name = 'ids'; input.value = id; container.appendChild(input);
            });
            document.getElementById('exportForm').submit();
        });
    })();
</script>
