@using Domain.Entities
@model List<Role>
@{ Layout="_AdminLayout"; ViewData["Title"]="Vai trò và quyền"; var permissions=ViewBag.Permissions as List<Permission>??new(); var counts=ViewBag.UserCounts as Dictionary<int,int>??new(); }
<div class="mb-4"><h1 class="fw-bold mb-1">Vai trò và quyền</h1><p class="text-muted mb-0">Kiểm soát quyền truy cập của từng nhóm người dùng.</p></div>@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}
<div class="row g-4">@foreach(var role in Model){<div class="col-xl-4"><form method="post" asp-action="UpdatePermissions" class="card border-0 shadow-sm h-100"><input type="hidden" name="roleId" value="@role.Id"/><div class="card-body"><div class="d-flex justify-content-between"><div><span class="badge bg-primary bg-opacity-10 text-primary mb-2">@role.Name</span><h4 class="fw-bold">@role.DisplayedName</h4></div><span class="text-muted small">@(counts.GetValueOrDefault(role.Id)) người dùng</span></div><p class="text-muted small">@role.Description</p><hr/><div class="fw-bold small mb-2">QUYỀN ĐƯỢC CẤP</div>@foreach(var p in permissions){var active=role.RolePermissions.Any(x=>x.PermissionId==p.Id);<label class="d-flex gap-2 py-2 border-bottom"><input class="form-check-input" type="checkbox" name="permissionIds" value="@p.Id" checked="@active"/><span><strong class="d-block small">@p.Name</strong><small class="text-muted">@p.Description</small></span></label>}</div><div class="card-footer border-0 bg-white p-3"><button class="btn btn-primary w-100">Lưu phân quyền</button></div></form></div>}</div>
