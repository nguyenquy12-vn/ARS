@{
    ViewData["Title"] = "Trang chủ - Kết nối cơ hội, dẫn lối thành công";
}

@functions {
    public string FormatSalary(int? min, int? max)
    {
        if (min.HasValue && max.HasValue)
            return $"{min.Value / 1000000} - {max.Value / 1000000} triệu VNĐ";
        if (min.HasValue)
            return $"Từ {min.Value / 1000000} triệu VNĐ";
        if (max.HasValue)
            return $"Đến {max.Value / 1000000} triệu VNĐ";
        return "Thỏa thuận";
    }
}

<!-- Hero Section -->
<section class="hero-section text-center text-white">
    <!-- Animated Blobs -->
    <div class="blob-1"></div>
    <div class="blob-2"></div>
    <div class="blob-3"></div>

    <!-- Floating UI Badges for Premium Look -->
    <div class="floating-card floating-card-1">
        <div class="fc-icon bg-success-subtle text-success">
            <i class="bi bi-patch-check-fill"></i>
        </div>
        <div>
            <div>12,000+ Việc làm đã xác thực</div>
        </div>
    </div>
    <div class="floating-card floating-card-2">
        <div class="fc-icon bg-info-subtle text-info">
            <i class="bi bi-briefcase-fill"></i>
        </div>
        <div>
            <div>500+ Doanh nghiệp tuyển dụng</div>
        </div>
    </div>

    <div class="container hero-content">
        <!-- Live status badge -->
        <div class="hero-badge fade-in-up">
            <span class="badge-dot"></span>
            Nền tảng tuyển dụng thông minh thế hệ mới
        </div>

        <h1 class="hero-title fade-in-up-delay-1">
            Khám phá <span class="highlight">Cơ hội Nghề nghiệp</span><br>Bứt phá Giới hạn của Bạn
        </h1>
        
        <p class="hero-subtitle fade-in-up-delay-2">
            ARS kết nối hàng ngàn ứng viên tài năng với các cơ hội nghề nghiệp hàng đầu từ những tập đoàn đa quốc gia và startup công nghệ tiên phong.
        </p>
        
        <!-- Premium Glassmorphic Search Form -->
        <div class="search-form-wrapper fade-in-up-delay-3">
            <form action="/Job" method="get" class="search-form">
                <i class="bi bi-search search-icon"></i>
                <input type="text" name="keyword" placeholder="Nhập tên công việc, vị trí, kỹ năng mong muốn...">
                <button type="submit" class="btn-search">Tìm kiếm ngay</button>
            </form>
            <div class="search-tags mt-3">
                <span class="me-2 text-white-50">Xu hướng tìm kiếm:</span>
                <span class="search-tag" onclick="fillSearch('React')">React</span>
                <span class="search-tag" onclick="fillSearch('ASP.NET Core')">ASP.NET</span>
                <span class="search-tag" onclick="fillSearch('UI/UX Designer')">UI/UX</span>
                <span class="search-tag" onclick="fillSearch('DevOps')">DevOps</span>
            </div>
        </div>

        <!-- Dynamic Statistics -->
        <div class="hero-stats">
            <div class="stat-item">
                <span class="stat-number">98%</span>
                <span class="stat-label">Ứng viên hài lòng</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">250K+</span>
                <span class="stat-label">Hồ sơ ứng tuyển</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">15+</span>
                <span class="stat-label">Lĩnh vực hàng đầu</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">5M+</span>
                <span class="stat-label">Mức lương trung bình</span>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="categories-section py-5">
    <div class="container py-4">
        <div class="text-center mb-5 reveal">
            <div class="section-badge">
                <i class="bi bi-grid-fill me-1"></i> Danh mục ngành nghề
            </div>
            <h2 class="section-title">Khám phá các lĩnh vực nổi bật</h2>
            <div class="section-divider"></div>
            <p class="text-muted max-w-md mx-auto fs-5">Hãy bắt đầu hành trình của bạn bằng cách chọn đúng lĩnh vực chuyên môn của mình</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            @if (ViewBag.Categories != null)
            {
                var categories = (IEnumerable<dynamic>)ViewBag.Categories;
                var icons = new[] { "bi-code-slash", "bi-graph-up-arrow", "bi-megaphone", "bi-palette", "bi-cpu", "bi-building-gear", "bi-cash-coin", "bi-headset" };
                int iconIndex = 0;
                
                foreach (var cat in categories)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 reveal reveal-delay-@(iconIndex % 4)">
                        <a href="/Job?categoryId=@cat.Id" class="text-decoration-none">
                            <div class="category-card h-100">
                                <div class="category-icon-wrapper shadow-sm">
                                    <i class="bi @icons[iconIndex % icons.Length] cat-icon text-primary"></i>
                                </div>
                                <h5 class="cat-title">@cat.Name</h5>
                                <div class="cat-count">Nhiều cơ hội mới</div>
                            </div>
                        </a>
                    </div>
                    iconIndex++;
                }
            }
            else
            {
                <div class="col-12 text-center text-muted">
                    <p>Không có danh mục nào được tìm thấy.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Latest Jobs Section -->
<section class="latest-jobs-section py-5">
    <div class="container py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-5 reveal">
            <div>
                <div class="section-badge">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Cơ hội mới mỗi ngày
                </div>
                <h2 class="section-title mb-2">Việc làm mới nhất</h2>
                <p class="text-muted mb-0 fs-5">Những vị trí tiềm năng vừa được đăng tải với mức đãi ngộ hấp dẫn</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="/Job" class="btn btn-outline-primary rounded-pill px-4 py-2">
                    Xem tất cả công việc <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
        
        <div class="row g-4">
            @if (ViewBag.LatestJobs != null)
            {
                int jobIndex = 0;
                foreach (var job in ViewBag.LatestJobs)
                {
                    <div class="col-lg-4 col-md-6 reveal reveal-delay-@(jobIndex % 3)">
                        <div class="job-card">
                            <div class="d-flex align-items-center mb-3">
                                <div class="company-logo bg-light text-primary fw-bold d-flex align-items-center justify-content-center me-3 flex-shrink-0">
                                    @if (!string.IsNullOrEmpty(job.CompanyLogoPath))
                                    {
                                        <img src="@job.CompanyLogoPath" alt="logo" class="img-fluid">
                                    }
                                    else
                                    {
                                        @(string.IsNullOrEmpty(job.CompanyName) ? "J" : job.CompanyName.Substring(0,1).ToUpper())
                                    }
                                </div>
                                <div class="overflow-hidden">
                                    <h5 class="job-title-text text-truncate" title="@job.Title">@job.Title</h5>
                                    <p class="job-company-name text-truncate mb-0">@job.CompanyName</p>
                                </div>
                            </div>
                            
                            <div class="job-meta mb-3">
                                <div class="job-meta-row">
                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                    <span>@job.Location</span>
                                </div>
                                <div class="job-meta-row">
                                    <i class="bi bi-cash-stack text-success"></i>
                                    <span class="salary-text">@FormatSalary(job.MinSalary, job.MaxSalary)</span>
                                </div>
                            </div>
                            
                            <div class="job-tags mb-4">
                                <span class="job-badge badge-type">@job.JobTypeName</span>
                                <span class="job-badge badge-mode">@job.WorkModeName</span>
                            </div>
                            
                            <div class="mt-auto">
                                <a href="/Job/Detail/@job.Id" class="btn-view-detail">
                                    Xem chi tiết <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    jobIndex++;
                }
            }
            else
            {
                <div class="col-12">
                    <div class="empty-state">
                        <i class="bi bi-briefcase text-muted fs-1 mb-3 d-block"></i>
                        <p class="text-muted">Hiện tại chưa có tin tuyển dụng nào mới.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Features Section (Why Choose Us) -->
<section class="features-section py-5">
    <div class="container py-4">
        <div class="text-center mb-5 reveal">
            <div class="section-badge">
                <i class="bi bi-shield-check me-1"></i> Giá trị khác biệt
            </div>
            <h2 class="section-title">Tại sao chọn ARS Tuyển Dụng?</h2>
            <div class="section-divider"></div>
            <p class="text-muted max-w-md mx-auto fs-5">Chúng tôi xây dựng giải pháp kết nối tuyển dụng toàn diện và chuyên nghiệp nhất</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4 reveal">
                <div class="feature-card">
                    <div class="feature-icon-wrap bg-primary-subtle text-primary">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                    <h4>Gợi ý thông minh</h4>
                    <p class="text-muted mb-0">Hệ thống phân tích CV tự động đề xuất những vị trí công việc tiệm cận nhất với kinh nghiệm và trình độ chuyên môn của bạn.</p>
                </div>
            </div>
            <div class="col-md-4 reveal reveal-delay-1">
                <div class="feature-card">
                    <div class="feature-icon-wrap bg-info-subtle text-info">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h4>Bảo mật tuyệt đối</h4>
                    <p class="text-muted mb-0">Thông tin cá nhân và tài liệu CV của ứng viên luôn được mã hóa, bảo mật tuyệt đối, chỉ chia sẻ với các nhà tuyển dụng uy tín.</p>
                </div>
            </div>
            <div class="col-md-4 reveal reveal-delay-2">
                <div class="feature-card">
                    <div class="feature-icon-wrap bg-success-subtle text-success">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <h4>Phản hồi nhanh chóng</h4>
                    <p class="text-muted mb-0">Thông báo trực tiếp trạng thái duyệt hồ sơ từ nhà tuyển dụng giúp bạn nắm bắt cơ hội phỏng vấn sớm nhất có thể.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="cta-blob-1"></div>
    <div class="cta-blob-2"></div>
    <div class="container cta-content reveal">
        <h2 class="cta-title">Bắt đầu hành trình kiến tạo tương lai</h2>
        <p class="cta-subtitle">Đăng ký tài khoản ứng viên miễn phí ngay hôm nay để nhận được đề xuất công việc tốt nhất từ hệ thống ARS.</p>
        <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-3">
            <a href="/Auth/Register" class="btn-cta text-decoration-none">
                Đăng ký ứng tuyển ngay <i class="bi bi-arrow-right-short fs-4"></i>
            </a>
            <a href="/Job" class="btn-cta-outline text-decoration-none">
                Khám phá thêm việc làm
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function fillSearch(val) {
            document.querySelector('.search-form input').value = val;
            document.querySelector('.search-form').submit();
        }

        // Scroll reveal logic
        document.addEventListener('DOMContentLoaded', function() {
            const reveals = document.querySelectorAll('.reveal');
            
            function checkReveal() {
                const triggerBottom = window.innerHeight * 0.85;
                reveals.forEach(reveal => {
                    const revealTop = reveal.getBoundingClientRect().top;
                    if (revealTop < triggerBottom) {
                        reveal.classList.add('revealed');
                    }
                });
            }
            
            window.addEventListener('scroll', checkReveal);
            checkReveal(); // Trigger once on load
        });
    </script>
}