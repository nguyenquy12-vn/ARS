@model List<Domain.Entities.JobCategory>
@{ Layout="_AdminLayout"; ViewData["Title"]="Ngành nghề"; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><h1 class="fw-bold mb-1">Ngành nghề tuyển dụng</h1><p class="text-muted mb-0">Quản lý danh mục dùng để phân loại tin tuyển dụng.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editModal" onclick="prepareCategory()"><i class="bi bi-plus-lg"></i> Thêm ngành nghề</button></div>
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Ngành nghề</th><th>Mô tả</th><th>Số tin</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="fw-bold">@item.Name</td><td class="text-muted">@(item.Description ?? "—")</td><td><span class="badge bg-primary bg-opacity-10 text-primary">@item.JobPostings.Count</span></td><td class="text-end"><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal" onclick='prepareCategory(@item.Id,@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Name)),@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Description)))'><i class="bi bi-pencil"></i></button><form method="post" asp-action="Delete" class="d-inline" onsubmit="return confirm('Xóa ngành nghề này?')"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr>}</tbody></table></div></div>
<div class="modal fade" id="editModal"><div class="modal-dialog"><form method="post" asp-action="Save" class="modal-content"><div class="modal-header"><h5 class="modal-title">Thông tin ngành nghề</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" id="categoryId" name="id"/><label class="form-label">Tên ngành nghề</label><input id="categoryName" name="name" class="form-control mb-3" maxlength="100" required/><label class="form-label">Mô tả</label><textarea id="categoryDescription" name="description" class="form-control" rows="3" maxlength="250"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Lưu thay đổi</button></div></form></div></div>
@section Scripts{<script>function prepareCategory(id='',name='',description=''){document.getElementById('categoryId').value=id;document.getElementById('categoryName').value=name||'';document.getElementById('categoryDescription').value=description||''}</script>}
