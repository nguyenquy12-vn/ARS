@model Services.DTOs.JobPosting.JobPostingDetail
@{
    ViewData["Title"] = Model.Title;

    string SalaryText()
    {
        if (Model.MinSalary.HasValue && Model.MaxSalary.HasValue)
            return $"{Model.MinSalary.Value:n0} - {Model.MaxSalary.Value:n0} VNĐ";
        if (Model.MinSalary.HasValue)
            return $"Từ {Model.MinSalary.Value:n0} VNĐ";
        if (Model.MaxSalary.HasValue)
            return $"Tối đa {Model.MaxSalary.Value:n0} VNĐ";
        return "Thỏa thuận";
    }
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">@Model.Title</h3>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Sửa</a>
            <a asp-controller="Application" asp-action="ByJob" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm">Xem ứng viên (@Model.ApplicationCount)</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Quay lại danh sách</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-4">
            <div class="row mb-2">
                <div class="col-md-3 text-muted">Công ty</div>
                <div class="col-md-9 fw-semibold">@Model.CompanyName</div>
            </div>
            <div class="row mb-2">
                <div class="col-md-3 text-muted">Ngành nghề</div>
                <div class="col-md-9">@Model.CategoryName</div>
            </div>
            <div class="row mb-2">
                <div class="col-md-3 text-muted">Địa điểm</div>
                <div class="col-md-9">@Model.Location</div>
            </div>
            <div class="row mb-2">
                <div class="col-md-3 text-muted">Loại hình / Hình thức</div>
                <div class="col-md-9">@Model.JobType &middot; @Model.WorkMode</div>
            </div>
            <div class="row mb-2">
                <div class="col-md-3 text-muted">Mức lương</div>
                <div class="col-md-9">@SalaryText()</div>
            </div>
            <div class="row mb-2">
                <div class="col-md-3 text-muted">Số lượng tuyển</div>
                <div class="col-md-9">@Model.Vacancies</div>
            </div>
            <div class="row mb-2">
                <div class="col-md-3 text-muted">Trạng thái</div>
                <div class="col-md-9">@Model.Status</div>
            </div>
            <div class="row mb-2">
                <div class="col-md-3 text-muted">Hạn nộp hồ sơ</div>
                <div class="col-md-9">@Model.ExpiredAt.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="row mb-2">
                <div class="col-md-3 text-muted">Số ứng viên</div>
                <div class="col-md-9">@Model.ApplicationCount</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-4">
            <h5 class="fw-bold">Mô tả công việc</h5>
            <p style="white-space: pre-line">@Model.Description</p>

            <h5 class="fw-bold mt-4">Yêu cầu ứng viên</h5>
            <p style="white-space: pre-line">@Model.Requirements</p>

            @if (!string.IsNullOrWhiteSpace(Model.Benefits))
            {
                <h5 class="fw-bold mt-4">Quyền lợi</h5>
                <p style="white-space: pre-line">@Model.Benefits</p>
            }
        </div>
    </div>
</div>
