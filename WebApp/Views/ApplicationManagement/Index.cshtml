@using Domain.Entities
@using Domain.Enums
@model List<Application>
@{ Layout="_AdminLayout"; ViewData["Title"]="Quản lý đơn ứng tuyển"; string badge(ApplicationStatus s)=>s==ApplicationStatus.Accepted?"success":s==ApplicationStatus.Rejected?"danger":s==ApplicationStatus.Interview?"primary":"warning"; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><h1 class="fw-bold mb-1">Đơn ứng tuyển</h1><p class="text-muted mb-0">Theo dõi toàn bộ hồ sơ ứng tuyển trên hệ thống.</p></div><span class="badge bg-primary rounded-pill px-3 py-2">@ViewBag.Total đơn</span></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 shadow-sm p-3"><small class="text-muted">TỔNG ĐƠN</small><strong class="fs-3">@ViewBag.Total</strong></div></div><div class="col-md-4"><div class="card border-0 shadow-sm p-3"><small class="text-muted">ĐÃ CHẤP NHẬN</small><strong class="fs-3 text-success">@ViewBag.Accepted</strong></div></div><div class="col-md-4"><div class="card border-0 shadow-sm p-3"><small class="text-muted">ĐÃ TỪ CHỐI</small><strong class="fs-3 text-danger">@ViewBag.Rejected</strong></div></div></div>
<div class="card border-0 shadow-sm"><div class="card-body border-bottom"><form method="get" class="row g-2"><div class="col-md"><input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm ứng viên, email hoặc vị trí..." /></div><div class="col-md-3"><select class="form-select" name="status"><option value="">Mọi trạng thái</option>@foreach(var s in Enum.GetValues<ApplicationStatus>()){<option value="@s" selected="@(ViewBag.Status?.ToString()==s.ToString())">@s</option>}</select></div><div class="col-auto"><button class="btn btn-primary"><i class="bi bi-search"></i> Lọc</button></div></form></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Ứng viên</th><th>Vị trí / Công ty</th><th>Điểm AI</th><th>Trạng thái</th><th>Ngày nộp</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.Candidate?.FullName</strong><small class="d-block text-muted">@item.Candidate?.Email</small></td><td>@item.JobPosting?.Title<small class="d-block text-muted">@item.JobPosting?.Company?.CompanyName</small></td><td><strong class="text-primary">@(item.AiMatchScore?.ToString() ?? "—")</strong></td><td><span class="badge bg-@badge(item.Status) bg-opacity-10 text-@badge(item.Status)">@item.Status</span></td><td>@item.AppliedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted py-5">Không có đơn ứng tuyển phù hợp.</td></tr>}</tbody></table></div></div>
