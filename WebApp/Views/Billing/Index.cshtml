@using Domain.Enums
@model List<Domain.Entities.PaymentOrder>
@{
    ViewData["Title"] = "Gói & thanh toán";
    var currentPlan = ViewBag.CurrentPlan as string;
    var hasStarter = currentPlan == "Starter";
    var hasPro = currentPlan == "Pro";
    var pendingOrders = Model.Where(x => x.Status == PaymentStatus.PendingConfirmation).ToList();
    string StatusLabel(PaymentStatus status) => status switch { PaymentStatus.Successful => "Thành công", PaymentStatus.Failed => "Thất bại", PaymentStatus.Cancelled => "Đã hủy", _ => "Chưa thanh toán" };
    string StatusClass(PaymentStatus status) => status switch { PaymentStatus.Successful => "bg-success", PaymentStatus.Failed => "bg-danger", PaymentStatus.Cancelled => "bg-secondary", _ => "bg-warning text-dark" };
}

<div class="d-flex justify-content-between align-items-end mb-4"><div><div class="text-primary small fw-bold text-uppercase">ARS dành cho recruiter</div><h2 class="fw-bold mb-1">Gói dịch vụ & thanh toán</h2><p class="text-muted mb-0">Thanh toán bảo mật qua VNPAY và kích hoạt gói tự động sau khi giao dịch thành công.</p></div></div>
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

<div class="card border-0 shadow-sm mb-4"><div class="card-body d-flex align-items-center gap-3 p-4"><div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width:48px;height:48px"><i class="bi bi-patch-check-fill fs-4"></i></div><div><div class="small text-muted text-uppercase fw-bold">Gói hiện tại</div><div class="fs-4 fw-bold">@(hasPro ? "Pro" : hasStarter ? "Starter" : "Chưa kích hoạt gói")</div></div><div class="ms-auto text-end small text-muted">@(hasPro ? "Bạn đang dùng đầy đủ tính năng Pro." : hasStarter ? "Bạn có thể nâng cấp lên Pro bất kỳ lúc nào." : "Chọn một gói để bắt đầu sử dụng.")</div></div></div>

@if (pendingOrders.Any())
{
    <div class="alert alert-warning border-0 shadow-sm mb-4"><i class="bi bi-hourglass-split me-2"></i><strong>Bạn đang có đơn chưa hoàn tất.</strong> Hãy tiếp tục qua VNPAY hoặc hủy đơn trước khi chọn gói khác.</div>
    <div class="row g-3 mb-5">
        @foreach (var item in pendingOrders)
        {
            <div class="col-md-6"><div class="card border-warning h-100"><div class="card-body p-4"><span class="badge bg-warning text-dark mb-2">Chưa thanh toán</span><h4 class="fw-bold">Gói @item.PlanName</h4><div class="fs-4 fw-bold text-primary">@item.Amount.ToString("N0")đ</div><div class="small text-muted mt-2">Mã đơn hàng: <code>@item.TransferCode</code></div><div class="d-flex gap-2 mt-4"><a asp-action="Checkout" asp-route-id="@item.Id" class="btn btn-primary">Thanh toán qua VNPAY</a><form asp-action="CancelOrder" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button type="submit" class="btn btn-outline-danger" onclick="return confirm('Hủy đơn thanh toán này?')">Hủy đơn</button></form></div></div></div></div>
        }
    </div>
}
else if (hasPro)
{
    <div class="alert alert-success border-0 shadow-sm py-4"><i class="bi bi-stars me-2"></i><strong>Gói Pro đang hoạt động.</strong> Đây là gói cao nhất, nên tài khoản không thể mua thêm gói khác.</div>
}
else
{
    <div class="row g-4 mb-5">
        @if (!hasStarter)
        {
            <div class="col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="badge bg-light text-primary mb-3">Dành cho doanh nghiệp nhỏ</span><h3>Starter</h3><div class="display-6 fw-bold">690.000đ<small class="fs-6 text-muted">/tháng</small></div><ul class="text-muted mt-3"><li>Tối đa 3 recruiter</li><li>CV và tin tuyển dụng không giới hạn</li><li>Thông báo và lịch phỏng vấn</li></ul><form asp-action="CreateOrder" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planCode" value="Starter" /><button class="btn btn-outline-primary w-100 fw-bold">Chọn Starter</button></form></div></div></div>
        }
        <div class="col-md-6"><div class="card h-100 border-primary shadow"><div class="card-body p-4"><span class="badge bg-primary mb-3">@(hasStarter ? "Nâng cấp" : "Phổ biến")</span><h3>Pro</h3><div class="display-6 fw-bold">1.490.000đ<small class="fs-6 text-muted">/tháng</small></div><ul class="text-muted mt-3"><li>Tối đa 10 recruiter</li><li>AI chấm và lọc CV</li><li>Kho CV và báo cáo tuyển dụng</li></ul><form asp-action="CreateOrder" method="post">@Html.AntiForgeryToken()<input type="hidden" name="planCode" value="Pro" /><button class="btn btn-primary w-100 fw-bold">@(hasStarter ? "Nâng cấp lên Pro" : "Chọn Pro")</button></form></div></div></div>
    </div>
}

<h5 class="fw-bold mb-3">Lịch sử thanh toán</h5>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Mã chuyển khoản</th><th>Gói</th><th>Số tiền</th><th>Ngày tạo</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var item in Model) { <tr><td class="fw-bold">@item.TransferCode</td><td>@item.PlanName</td><td>@item.Amount.ToString("N0")đ</td><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td><td>@if(item.Status == PaymentStatus.PendingConfirmation){<a asp-action="Checkout" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Tiếp tục</a>}</td></tr> }
@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-4">Chưa có đơn thanh toán.</td></tr>}
</tbody></table></div></div>
