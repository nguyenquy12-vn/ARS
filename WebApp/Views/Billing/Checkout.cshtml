@model Domain.Entities.PaymentOrder
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    var bankId = (string)ViewBag.BankId;
    var accountNumber = (string)ViewBag.AccountNumber;
    var accountName = (string)ViewBag.AccountName;
    var qr = $"https://img.vietqr.io/image/{bankId}-{accountNumber}-compact2.png?amount={Model.Amount:0}&addInfo={Uri.EscapeDataString(Model.TransferCode)}&accountName={Uri.EscapeDataString(accountName)}";
}
<div class="row justify-content-center"><div class="col-lg-9">
    <a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Quay lại gói</a>
    @if (TempData["VnPayError"] != null) { <div class="alert alert-warning mt-3">@TempData["VnPayError"]</div> }
    <div class="card border-0 shadow-sm mt-3"><div class="card-body p-4 p-md-5">
        <div class="text-center"><div class="text-primary small fw-bold text-uppercase">Đơn chờ Admin xác nhận</div><h2 class="fw-bold mt-2">Chọn phương thức thanh toán</h2><p class="text-muted">Gói <strong>@Model.PlanName</strong> · <strong class="text-primary">@Model.Amount.ToString("N0")đ</strong></p></div>
        <div class="row g-4 mt-1">
            <div class="col-md-6"><div class="border rounded-4 p-4 h-100"><div class="d-flex align-items-center gap-2"><i class="bi bi-qr-code-scan fs-3 text-primary"></i><div><h5 class="mb-0 fw-bold">Quét mã VietQR</h5><small class="text-muted">Chuyển khoản ngân hàng</small></div></div><img src="@qr" class="img-fluid border rounded-4 p-2 my-3 d-block mx-auto" style="max-width:230px" alt="Mã QR thanh toán" /><div class="small text-muted">Nội dung bắt buộc</div><code class="fs-6">@Model.TransferCode</code><p class="small text-muted mt-3">Sau khi chuyển khoản, hãy xác nhận để Admin đối chiếu.</p><form asp-action="ConfirmQrPayment" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button type="submit" class="btn btn-outline-primary w-100 fw-bold"><i class="bi bi-check2-circle me-2"></i>Đã thanh toán QR thành công</button></form></div></div>
            <div class="col-md-6"><div class="border rounded-4 p-4 h-100"><div class="d-flex align-items-center gap-2"><i class="bi bi-credit-card-2-front fs-3 text-primary"></i><div><h5 class="mb-0 fw-bold">Thẻ ngân hàng</h5><small class="text-muted">Cổng VNPay</small></div></div><p class="text-muted small mt-4">Bạn sẽ được chuyển đến cổng VNPay để chọn thẻ ATM nội địa, Visa, Mastercard hoặc JCB.</p><form asp-controller="VnPay" asp-action="CreatePayment" method="post">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@Model.Id"/><button type="submit" class="btn btn-primary w-100 fw-bold"><i class="bi bi-box-arrow-up-right me-2"></i>Thanh toán bằng thẻ</button></form><p class="small text-muted text-center mt-3 mb-0">Nếu cổng thanh toán chưa sẵn sàng, nút trên sẽ mở trang thanh toán thử nghiệm.</p></div></div>
        </div>
        <div class="alert alert-warning mt-4 mb-0"><i class="bi bi-shield-check me-2"></i>Dù thanh toán bằng phương thức nào, đơn vẫn là <strong>Chờ xác nhận</strong> cho đến khi Admin duyệt.</div>
    </div></div>
</div></div>
