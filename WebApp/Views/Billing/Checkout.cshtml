@model Domain.Entities.PaymentOrder
@{ ViewData["Title"] = "Thanh toán VNPAY"; }
<div class="row justify-content-center"><div class="col-lg-7"><a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Quay lại gói</a><div class="card border-0 shadow-sm mt-3 overflow-hidden"><div class="card-body p-4 p-md-5"><div class="text-center"><div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px"><i class="bi bi-qr-code-scan fs-2"></i></div><div class="small text-primary fw-bold text-uppercase">Thanh toán tự động qua VNPAY Sandbox</div><h2 class="fw-bold mt-2">Thanh toán gói @Model.PlanName</h2><p class="text-muted">Số tiền thanh toán: <strong class="text-primary fs-5">@Model.Amount.ToString("N0")đ</strong></p></div><div class="alert alert-light border mt-4"><div class="d-flex gap-2"><i class="bi bi-info-circle-fill text-primary"></i><div class="small"><strong>Quét QR VNPAY Demo:</strong> bấm nút bên dưới, tại cổng VNPAY chọn phương thức <strong>VNPAY-QR / QR</strong> nếu được hiển thị. Giao dịch thành công sẽ kích hoạt gói tự động.</div></div></div><form asp-controller="VnPay" asp-action="CreatePayment" method="post" class="mt-4">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@Model.Id" /><button type="submit" class="btn btn-primary w-100 fw-bold py-3"><i class="bi bi-box-arrow-up-right me-2"></i>Mở cổng thanh toán VNPAY</button></form><p class="small text-muted text-center mt-3 mb-0"><i class="bi bi-shield-check me-1"></i>Không cần Admin duyệt sau khi VNPAY báo thành công.</p></div></div></div></div>
