@using System.Security.Claims
@inject Infrastructure.ARSDbContext DbContext
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ARS Nhà tuyển dụng</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/recruiter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-system.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Figtree', system-ui, sans-serif;
            background-color: #f4f7fb;
        }

        .recruiter-shell {
            display: flex;
            min-height: 100vh;
        }

        .recruiter-sidebar {
            width: 260px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .recruiter-sidebar .brand {
            padding: 1.25rem 1.5rem;
            font-weight: 800;
            font-size: 1.15rem;
            color: #fff;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .recruiter-sidebar .nav-link {
            padding: .75rem 1.5rem;
            display: flex;
            align-items: center;
            gap: .75rem;
            border-left: 3px solid transparent;
        }

        .recruiter-sidebar .nav-link.plan-locked {
            opacity: .48;
        }

        .recruiter-main {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .recruiter-topbar {
            padding: .85rem 1.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .recruiter-content {
            padding: 2rem;
            flex-grow: 1;
            max-width: 1280px;
            width: 100%;
        }

        @@media (max-width: 768px) {
            .recruiter-sidebar { width: 72px; }
            .recruiter-sidebar .brand span,
            .recruiter-sidebar .nav-link span { display: none; }
        }
    </style>
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        string NavActive(string controller, string? action = null) =>
            currentController == controller && (action is null || currentAction == action) ? "active" : "";
        var recruiterIdValue = User.FindFirstValue(ClaimTypes.NameIdentifier);
        var activeSubscription = int.TryParse(recruiterIdValue, out var recruiterId)
            ? DbContext.RecruiterSubscriptions.FirstOrDefault(subscription => subscription.RecruiterId == recruiterId && subscription.ExpiresAt > DateTime.UtcNow)
            : null;
        var hasActivePlan = activeSubscription != null;
        var hasProPlan = activeSubscription?.PlanCode == "Pro";
        string LockedClass() => hasActivePlan ? string.Empty : "plan-locked";
        string LockedTitle() => hasActivePlan ? string.Empty : "Mua gói và chờ Admin duyệt để mở khóa";
        string ProLockedClass() => hasProPlan ? string.Empty : "plan-locked";
        string ProLockedTitle() => hasProPlan ? string.Empty : "Chỉ khả dụng với gói Pro";
    }
    <div class="recruiter-shell">
        <aside class="recruiter-sidebar">
            <div class="brand">
                <i class="bi bi-briefcase-fill"></i>
                <span>ARS Recruiter</span>
            </div>
            <nav class="nav flex-column mt-2">
                <a class="nav-link @NavActive("JobPosting", "Index") @LockedClass()" asp-controller="JobPosting" asp-action="Index" title="@LockedTitle()">
                    <i class="bi bi-speedometer2"></i><span>Bảng điều hành</span>
                </a>
                <a class="nav-link @NavActive("JobPosting", "Create") @LockedClass()" asp-controller="JobPosting" asp-action="Create" title="@LockedTitle()">
                    <i class="bi bi-plus-square"></i><span>Đăng tin mới</span>
                </a>
                <a class="nav-link @NavActive("CvBank") @LockedClass() @ProLockedClass()" asp-controller="CvBank" asp-action="Index" title="@(hasActivePlan ? ProLockedTitle() : LockedTitle())">
                    <i class="bi bi-collection"></i><span>Kho CV</span>
                </a>
                <a class="nav-link @NavActive("Application", "Interviews") @LockedClass()" asp-controller="Application" asp-action="Interviews" title="@LockedTitle()">
                    <i class="bi bi-calendar2-week"></i><span>Lịch phỏng vấn</span>
                </a>
                <a class="nav-link @NavActive("Company") @LockedClass()" asp-controller="Company" asp-action="Index" title="@LockedTitle()">
                    <i class="bi bi-building"></i><span>Hồ sơ công ty</span>
                </a>
                <a class="nav-link @NavActive("Profile")" asp-controller="Profile" asp-action="Edit">
                    <i class="bi bi-person-gear"></i><span>Hồ sơ cá nhân</span>
                </a>
                <a class="nav-link @NavActive("Billing")" asp-controller="Billing" asp-action="Index">
                    <i class="bi bi-credit-card-2-front"></i><span>Gói & thanh toán</span>
                </a>
            </nav>
            <div class="mt-auto p-3 border-top border-secondary">
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light w-100 btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <div class="recruiter-main">
            <div class="recruiter-topbar">
                <h6 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h6>
                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Application" asp-action="Notifications" class="recruiter-notif-bell @LockedClass()" title="@LockedTitle()" aria-label="Thông báo">
                        <i class="bi bi-bell-fill"></i>
                        <span class="recruiter-notif-badge d-none" id="recruiter-notif-badge">0</span>
                    </a>
                    <span class="text-muted small d-flex align-items-center">
                        <i class="bi bi-person-circle fs-5 me-2"></i>
                        @User.FindFirstValue(ClaimTypes.Name)
                    </span>
                </div>
            </div>
            <main class="recruiter-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div id="recruiter-realtime-toast" class="recruiter-realtime-toast" role="status" aria-live="polite" hidden>
        <i class="bi bi-file-earmark-person-fill"></i>
        <div><strong id="recruiter-realtime-title"></strong><span id="recruiter-realtime-message"></span></div>
        <button type="button" aria-label="Đóng">&times;</button>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" referrerpolicy="no-referrer"></script>
    <script>
        (() => {
            const badge = document.getElementById('recruiter-notif-badge');
            if (!badge) return;
            const refreshNotifications = async () => {
                try {
                    const response = await fetch('@Url.Action("GetUnreadCount", "Application")', {
                        headers: { 'Accept': 'application/json' },
                        cache: 'no-store'
                    });
                    if (!response.ok) return;
                    const data = await response.json();
                    const count = Number(data.count) || 0;
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.classList.toggle('d-none', count === 0);
                } catch { /* Keep the navigation usable if polling is unavailable. */ }
            };
            refreshNotifications();
            window.setInterval(refreshNotifications, 15000);

            const toast = document.getElementById('recruiter-realtime-toast');
            const toastTitle = document.getElementById('recruiter-realtime-title');
            const toastMessage = document.getElementById('recruiter-realtime-message');
            let toastTimer;
            const showRealtimeToast = (notification) => {
                if (!toast || !toastTitle || !toastMessage) return;
                toastTitle.textContent = notification.title || 'Thông báo mới';
                toastMessage.textContent = notification.message || '';
                toast.hidden = false;
                clearTimeout(toastTimer);
                toastTimer = window.setTimeout(() => { toast.hidden = true; }, 7000);
            };

            toast?.querySelector('button')?.addEventListener('click', () => { toast.hidden = true; });
            if (window.signalR) {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/notifications')
                    .withAutomaticReconnect()
                    .build();
                connection.on('notification:new', (notification) => {
                    refreshNotifications();
                    showRealtimeToast(notification);
                });
                connection.start().catch(() => { /* Polling remains the fallback. */ });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
