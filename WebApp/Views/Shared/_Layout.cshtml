<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ARS Tuyển Dụng</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header">
        <nav class="navbar navbar-expand-lg navbar-dark bg-transparent">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-briefcase-fill fs-3 me-2"></i>
                    ARS Tuyển Dụng
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Job" asp-action="Index">Việc làm</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.HasClaim("Permission", "ApplyJob"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Candidate" asp-action="MyApplications">Việc làm đã ứng tuyển</a>
                            </li>
                        }
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Recruiter"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="JobPosting" asp-action="Index">Tin tuyển dụng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Company" asp-action="Index">Hồ sơ công ty</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex auth-section align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.HasClaim("Permission", "ApplyJob"))
                            {
                                <!-- Bell notification for candidates -->
                                <a asp-controller="Candidate" asp-action="Notifications"
                                   class="notif-bell position-relative text-white me-1" title="Hộp thư thông báo"
                                   id="notif-bell-link">
                                    <i class="bi bi-bell-fill fs-5"></i>
                                    <span class="notif-badge d-none" id="notif-badge">0</span>
                                </a>
                            }
                            <span class="navbar-text text-white me-1 d-flex align-items-center">
                                <i class="bi bi-person-circle fs-5 me-2"></i> Xin chào, @User.Identity.Name!
                            </span>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light rounded-pill px-4 btn-sm fw-medium mt-1">Đăng xuất</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light rounded-pill px-4 me-2 fw-medium">Đăng nhập</a>
                            <a asp-controller="Auth" asp-action="Register" class="btn btn-light rounded-pill px-4 text-primary fw-medium">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container-fluid p-0">
        @RenderBody()
    </main>

    <footer class="main-footer text-white py-5 mt-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3 d-flex align-items-center">
                        <i class="bi bi-briefcase-fill me-2"></i> ARS Tuyển Dụng
                    </h5>
                    <p class="text-white-50">Nền tảng kết nối ứng viên và nhà tuyển dụng hàng đầu, mang đến cơ hội việc làm tốt nhất cho bạn.</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5 class="fw-bold mb-3">Về chúng tôi</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Giới thiệu</a></li>
                        <li><a href="#">Liên hệ</a></li>
                        <li><a href="#">Bảo mật</a></li>
                        <li><a href="#">Điều khoản</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-3">Dành cho ứng viên</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/Job">Tìm việc làm</a></li>
                        <li><a href="#">Tạo CV</a></li>
                        <li><a href="#">Cẩm nang nghề nghiệp</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-3">Kết nối</h5>
                    <div class="social-links d-flex gap-2">
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="btn btn-outline-light btn-sm rounded-circle"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center text-white-50">
                &copy; @DateTime.Now.Year - ARS Tuyển Dụng. Đã đăng ký bản quyền.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        // Navbar scroll effect
        $(function() {
            function checkScroll() {
                if ($(window).scrollTop() > 50) {
                    $('.main-header').addClass('scrolled');
                } else {
                    $('.main-header').removeClass('scrolled');
                }
            }
            $(window).scroll(checkScroll);
            checkScroll();

            // Fetch unread notification count for candidates
            function fetchNotifCount() {
                var $badge = $('#notif-badge');
                if ($badge.length === 0) return;
                $.getJSON('/Candidate/GetUnreadCount', function(data) {
                    if (data.count > 0) {
                        $badge.text(data.count).removeClass('d-none');
                    } else {
                        $badge.addClass('d-none');
                    }
                });
            }
            fetchNotifCount();
            setInterval(fetchNotifCount, 60000); // refresh every 60s
        });
    </script>
</body>
</html>
