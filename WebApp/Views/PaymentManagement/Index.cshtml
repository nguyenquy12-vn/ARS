@using Domain.Enums
@model List<Domain.Entities.PaymentOrder>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Dashboard doanh thu";
decimal total = ViewBag.TotalRevenue ?? 0m, month = ViewBag.MonthRevenue ?? 0m, today = ViewBag.TodayRevenue ?? 0m; int count = ViewBag.SuccessCount ?? 0;
string Label(PaymentStatus s) => s == PaymentStatus.Successful ? "Thành công" : s == PaymentStatus.Failed ? "Thất bại" : s == PaymentStatus.Cancelled ? "Đã hủy" : "Chờ thanh toán";
string Color(PaymentStatus s) => s == PaymentStatus.Successful ? "bg-success" : s == PaymentStatus.Failed ? "bg-danger" : s == PaymentStatus.Cancelled ? "bg-secondary" : "bg-warning text-dark"; }
<div class="ui-page-heading mb-4"><div><span class="ui-eyebrow"><i class="bi bi-cash-stack"></i> Báo cáo thanh toán</span><h1>Dashboard doanh thu</h1><p>Doanh thu được ghi nhận tự động từ các giao dịch thanh toán thành công.</p></div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small fw-bold">DOANH THU HÔM NAY</div><div class="fs-3 fw-bold text-primary mt-2">@today.ToString("N0")đ</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small fw-bold">DOANH THU THÁNG NÀY</div><div class="fs-3 fw-bold text-success mt-2">@month.ToString("N0")đ</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small fw-bold">TỔNG DOANH THU · @count giao dịch</div><div class="fs-3 fw-bold mt-2">@total.ToString("N0")đ</div></div></div></div></div>
<div class="card border-0 shadow-sm"><div class="card-header bg-white border-0 pt-4 px-4"><h5 class="fw-bold mb-0">Lịch sử giao dịch</h5></div><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Recruiter</th><th>Gói</th><th>Số tiền</th><th>Thời gian</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="ps-4"><strong>@item.Recruiter?.FullName</strong><br/><small class="text-muted">@item.Recruiter?.Email</small></td><td>@item.PlanName</td><td class="fw-semibold">@item.Amount.ToString("N0")đ</td><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge @Color(item.Status)">@Label(item.Status)</span></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted py-5">Chưa có giao dịch.</td></tr>}</tbody></table></div></div>
