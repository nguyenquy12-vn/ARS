@using Domain.Enums
@model List<Domain.Entities.PaymentOrder>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Duyệt thanh toán";
    string StatusLabel(PaymentStatus status) => status switch { PaymentStatus.Successful => "Thành công", PaymentStatus.Failed => "Thất bại", PaymentStatus.Cancelled => "Đã hủy", _ => "Chờ xác nhận" };
    string StatusClass(PaymentStatus status) => status switch { PaymentStatus.Successful => "bg-success", PaymentStatus.Failed => "bg-danger", PaymentStatus.Cancelled => "bg-secondary", _ => "bg-warning text-dark" };
}
<h3 class="fw-bold mb-1">Duyệt thanh toán</h3><p class="text-muted mb-4">Chỉ Admin có thể xác nhận thành công hoặc thất bại.</p>
@if(TempData["Success"] != null){<div class="alert alert-success">@TempData["Success"]</div>} @if(TempData["Error"] != null){<div class="alert alert-danger">@TempData["Error"]</div>}
<div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Recruiter</th><th>Gói</th><th>Số tiền</th><th>Mã CK</th><th>Trạng thái</th><th>Duyệt</th></tr></thead><tbody>
@foreach(var item in Model){<tr><td><strong>@item.Recruiter?.FullName</strong><br/><small class="text-muted">@item.Recruiter?.Email</small></td><td>@item.PlanName</td><td>@item.Amount.ToString("N0")đ</td><td><code>@item.TransferCode</code></td><td><span class="badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td><td>@if(item.Status == PaymentStatus.PendingConfirmation){<small class="d-block text-muted mb-2">@item.AdminNote</small><form asp-action="Review" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><input class="form-control form-control-sm" name="adminNote" placeholder="Ghi chú"/><button class="btn btn-sm btn-success" name="status" value="Successful">Duyệt</button><button class="btn btn-sm btn-outline-danger" name="status" value="Failed">Từ chối</button></form>}else{<small class="text-muted">@item.AdminNote</small>}</td></tr>}
@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-4">Chưa có đơn thanh toán.</td></tr>}</tbody></table></div></div>
