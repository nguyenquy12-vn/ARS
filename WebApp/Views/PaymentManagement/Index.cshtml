@using Domain.Enums
@using WebApp.Controllers.Admin
@model List<Domain.Entities.PaymentOrder>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard doanh thu";
    decimal total = ViewBag.TotalRevenue ?? 0m, month = ViewBag.MonthRevenue ?? 0m, today = ViewBag.TodayRevenue ?? 0m;
    int count = ViewBag.SuccessCount ?? 0, starter = ViewBag.StarterSales ?? 0, pro = ViewBag.ProSales ?? 0;
    var series = ViewBag.DailyRevenue as List<PaymentManagementController.RevenuePoint> ?? new();
    var maximum = Math.Max(series.Any() ? series.Max(x => x.Amount) : 0, 1);
    var newest = Model.Take(6).ToList();
    string status(PaymentStatus s) => s == PaymentStatus.Successful ? "Thành công" : s == PaymentStatus.Failed ? "Thất bại" : s == PaymentStatus.Cancelled ? "Đã hủy" : "Đang thanh toán";
    string tone(PaymentStatus s) => s == PaymentStatus.Successful ? "success" : s == PaymentStatus.Failed ? "danger" : s == PaymentStatus.Cancelled ? "muted" : "warning";
}
<style>
 .revenue-page{color:#192d4b}.revenue-hero{position:relative;overflow:hidden;padding:2rem 2.25rem;border-radius:22px;color:#fff;background:linear-gradient(110deg,#102d56,#1469d8 58%,#43a7ff);box-shadow:0 17px 35px #0e4eaa2b}.revenue-hero:after{content:"";position:absolute;width:320px;height:320px;right:-60px;top:-160px;border:1px solid #ffffff55;border-radius:50%;box-shadow:0 0 0 35px #ffffff0e,0 0 0 70px #ffffff0a}.revenue-hero h1{position:relative;z-index:1;margin:.3rem 0 .35rem;font-size:2rem;font-weight:800;letter-spacing:-.05em}.revenue-hero p{position:relative;z-index:1;margin:0;color:#dceeff}.hero-label{font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#9ed9ff}.hero-total{position:absolute;z-index:1;right:2.25rem;bottom:1.85rem;text-align:right}.hero-total span{display:block;font-size:.72rem;color:#d2ebff}.hero-total strong{font-size:1.55rem}.metric-card{height:100%;padding:1.25rem;border:1px solid #e9eef6;border-radius:18px;background:#fff;box-shadow:0 8px 24px #173d6a0a}.metric-icon{display:grid;place-items:center;width:43px;height:43px;border-radius:13px;font-size:1.15rem}.metric-label{margin-top:1.1rem;color:#798aa2;font-size:.7rem;font-weight:800;letter-spacing:.07em}.metric-value{margin-top:.3rem;font-size:1.5rem;font-weight:800;letter-spacing:-.04em}.metric-note{color:#7d8da3;font-size:.75rem}.blue{color:#1267e9;background:#eaf3ff}.green{color:#10a66d;background:#e6f8f0}.purple{color:#7b52d1;background:#f2edff}.dash-card{border:1px solid #e8eef5;border-radius:20px;background:#fff;box-shadow:0 8px 25px #153b6b09}.dash-card-header{display:flex;justify-content:space-between;align-items:center;padding:1.35rem 1.45rem .4rem}.dash-title{margin:0;font-size:1rem;font-weight:800}.dash-subtitle{margin:.3rem 0 0;color:#8190a5;font-size:.78rem}.chart-area{display:flex;align-items:end;gap:clamp(.5rem,1.5vw,1.25rem);height:245px;padding:1.5rem 1.45rem 1.2rem;border-bottom:1px solid #edf1f6;background:repeating-linear-gradient(to bottom,transparent 0,transparent 59px,#edf2f8 60px)}.chart-column{display:flex;flex:1;flex-direction:column;justify-content:end;align-items:center;height:100%;min-width:28px}.chart-bar{width:min(42px,100%);min-height:6px;border-radius:10px 10px 3px 3px;background:linear-gradient(180deg,#59b9ff,#1267e9);box-shadow:0 7px 12px #1267e940;transition:.2s}.chart-bar:hover{filter:brightness(1.07);transform:translateY(-3px)}.chart-label{margin-top:.65rem;color:#8291a5;font-size:.7rem}.chart-value{margin-bottom:.35rem;color:#4c6484;font-size:.66rem;font-weight:700;white-space:nowrap}.plan-row{display:flex;align-items:center;gap:.85rem;padding:1rem 1.35rem}.plan-dot{width:11px;height:11px;border-radius:50%}.plan-track{flex:1;height:8px;overflow:hidden;border-radius:99px;background:#edf2f7}.plan-fill{height:100%;border-radius:inherit}.transaction{display:flex;align-items:center;gap:.75rem;padding:1rem 1.35rem;border-top:1px solid #f0f3f7}.avatar{display:grid;place-items:center;flex:0 0 38px;width:38px;height:38px;border-radius:12px;color:#1764c9;background:#eaf3ff;font-size:.8rem;font-weight:800}.transaction-name{font-size:.82rem;font-weight:800}.transaction-meta{color:#8896a9;font-size:.72rem}.transaction-amount{margin-left:auto;text-align:right;font-size:.82rem;font-weight:800}.status{display:inline-block;margin-top:.17rem;padding:.18rem .45rem;border-radius:99px;font-size:.62rem;font-weight:800}.status-success{color:#0b8757;background:#e5f8ee}.status-danger{color:#cf3f50;background:#ffedf0}.status-warning{color:#a36900;background:#fff5dd}.status-muted{color:#66778e;background:#edf1f6}@@media(max-width:768px){.revenue-hero{padding:1.5rem}.hero-total{position:relative;right:auto;bottom:auto;margin-top:1.2rem;text-align:left}.chart-area{gap:.45rem}.chart-value{display:none}}
</style>
<div class="revenue-page">
 <section class="revenue-hero mb-4"><div class="hero-label"><i class="bi bi-bar-chart-fill me-1"></i> ARS · Financial overview</div><h1>Dashboard doanh thu</h1><p>Theo dõi hiệu quả kinh doanh và các giao dịch gói dịch vụ theo thời gian thực.</p><div class="hero-total"><span>TỔNG DOANH THU ĐÃ GHI NHẬN</span><strong>@total.ToString("N0")đ</strong></div></section>
 <div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card"><div class="metric-icon blue"><i class="bi bi-calendar-day"></i></div><div class="metric-label">DOANH THU HÔM NAY</div><div class="metric-value">@today.ToString("N0")đ</div><div class="metric-note">Giao dịch thành công trong ngày</div></div></div><div class="col-md-4"><div class="metric-card"><div class="metric-icon green"><i class="bi bi-graph-up-arrow"></i></div><div class="metric-label">DOANH THU THÁNG NÀY</div><div class="metric-value">@month.ToString("N0")đ</div><div class="metric-note">Tổng thu theo tháng hiện tại</div></div></div><div class="col-md-4"><div class="metric-card"><div class="metric-icon purple"><i class="bi bi-receipt-cutoff"></i></div><div class="metric-label">GIAO DỊCH THÀNH CÔNG</div><div class="metric-value">@count</div><div class="metric-note">Đơn đã kích hoạt gói tự động</div></div></div></div>
 <div class="row g-4"><div class="col-xl-8"><section class="dash-card h-100"><div class="dash-card-header"><div><h2 class="dash-title">Doanh thu 7 ngày gần nhất</h2><p class="dash-subtitle">Chỉ tính giao dịch VNPAY thành công</p></div><span class="badge text-primary bg-primary bg-opacity-10 rounded-pill px-3 py-2">7 ngày</span></div><div class="chart-area">@foreach(var point in series){var height = Math.Max(5, Math.Round(point.Amount / maximum * 100));<div class="chart-column"><span class="chart-value">@point.Amount.ToString("N0")đ</span><div class="chart-bar" title="@point.Amount.ToString("N0")đ" style="height:@height%"></div><span class="chart-label">@point.Label</span></div>}</div><div class="p-4 pt-3 small text-muted"><i class="bi bi-info-circle me-1"></i> Biểu đồ được tính từ thời điểm VNPAY trả về kết quả thành công.</div></section></div><div class="col-xl-4"><section class="dash-card h-100"><div class="dash-card-header"><div><h2 class="dash-title">Cơ cấu gói bán</h2><p class="dash-subtitle">Theo số giao dịch thành công</p></div></div><div class="plan-row"><span class="plan-dot" style="background:#1769e8"></span><div style="width:65px"><strong class="small">Starter</strong></div><div class="plan-track"><div class="plan-fill" style="background:#1769e8;width:@(count == 0 ? 0 : starter * 100 / count)%"></div></div><strong class="small">@starter</strong></div><div class="plan-row"><span class="plan-dot" style="background:#7b52d1"></span><div style="width:65px"><strong class="small">Pro</strong></div><div class="plan-track"><div class="plan-fill" style="background:#7b52d1;width:@(count == 0 ? 0 : pro * 100 / count)%"></div></div><strong class="small">@pro</strong></div><div class="m-4 p-3 rounded-4" style="background:#f4f8ff"><div class="small text-muted">GIÁ TRỊ TRUNG BÌNH / GIAO DỊCH</div><div class="fs-5 fw-bold text-primary mt-1">@(count == 0 ? "0đ" : (total / count).ToString("N0") + "đ")</div></div></section></div></div>
 <section class="dash-card mt-4"><div class="dash-card-header"><div><h2 class="dash-title">Giao dịch mới nhất</h2><p class="dash-subtitle">Cập nhật từ hệ thống thanh toán</p></div><span class="small text-muted">@Model.Count giao dịch</span></div><div class="pb-2">@foreach(var item in newest){var initials = string.Concat((item.Recruiter?.FullName ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0]));<div class="transaction"><div class="avatar">@initials</div><div><div class="transaction-name">@item.Recruiter?.FullName</div><div class="transaction-meta">@item.PlanName · @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div><div class="transaction-amount">@item.Amount.ToString("N0")đ<br/><span class="status status-@tone(item.Status)">@status(item.Status)</span></div></div>}@if(!newest.Any()){<div class="text-center text-muted py-5"><i class="bi bi-receipt fs-2 d-block mb-2"></i>Chưa có giao dịch nào.</div>}</div></section>
</div>
