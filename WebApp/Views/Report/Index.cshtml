@model WebApp.Models.Admin.AdminReportViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Báo cáo hệ thống"; var trendMax = Math.Max(Model.MonthlyApplications.Concat(Model.MonthlyUsers).Select(x => x.Value).DefaultIfEmpty(1).Max(), 1); }
<style>
.report-page{color:#192d4b}.report-hero{display:flex;justify-content:space-between;align-items:end;padding:2rem 2.2rem;border-radius:22px;color:#fff;background:linear-gradient(115deg,#102b52,#1268db 64%,#49b2f5);box-shadow:0 16px 35px #1258b52b}.report-hero h1{margin:.35rem 0;font-size:2rem;font-weight:800;letter-spacing:-.04em}.report-hero p{margin:0;color:#d9ecff}.hero-tag{font-size:.7rem;font-weight:800;letter-spacing:.12em;color:#9fdaff}.hero-rate{text-align:right}.hero-rate strong{display:block;font-size:2.2rem}.hero-rate span{font-size:.72rem;color:#d4e9ff}.report-kpi{height:100%;padding:1.25rem;border:1px solid #e5ebf3;border-radius:17px;background:#fff;box-shadow:0 7px 22px #16395f0b}.report-kpi i{display:grid;width:42px;height:42px;place-items:center;border-radius:12px;color:#1268dd;background:#eaf3ff}.report-kpi small{display:block;margin-top:1rem;color:#7e8da2;font-size:.66rem;font-weight:800;letter-spacing:.08em}.report-kpi strong{display:block;margin-top:.25rem;font-size:1.45rem}.report-card{height:100%;border:1px solid #e5eaf2;border-radius:18px;background:#fff;box-shadow:0 7px 22px #15365d0a;overflow:hidden}.report-head{padding:1.25rem 1.4rem;border-bottom:1px solid #edf1f5}.report-head h2{margin:0;font-size:1rem;font-weight:800}.report-head p{margin:.25rem 0 0;color:#8593a6;font-size:.72rem}.bars{padding:1rem 1.4rem}.bar-row{display:grid;grid-template-columns:minmax(105px,145px) 1fr 35px;gap:.8rem;align-items:center;margin:.9rem 0;font-size:.76rem}.bar-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar-track{height:9px;border-radius:99px;background:#edf1f6;overflow:hidden}.bar-fill{height:100%;min-width:4px;border-radius:inherit;background:linear-gradient(90deg,#1769e8,#52b5f5)}.trend-chart{display:flex;align-items:end;gap:1rem;height:255px;padding:1.5rem 1.4rem 1rem;background:repeating-linear-gradient(to bottom,#fff 0,#fff 58px,#edf1f5 59px)}.trend-group{display:flex;flex:1;align-items:end;justify-content:center;gap:5px;height:100%;position:relative;padding-bottom:25px}.trend-bar{width:min(22px,42%);min-height:3px;border-radius:7px 7px 2px 2px}.trend-app{background:#1769e8}.trend-user{background:#68c7d9}.trend-label{position:absolute;bottom:0;color:#8996a8;font-size:.64rem;white-space:nowrap}.legend{display:flex;gap:1rem;padding:0 1.4rem 1.2rem;color:#718096;font-size:.7rem}.legend span:before{content:'';display:inline-block;width:8px;height:8px;margin-right:5px;border-radius:2px;background:#1769e8}.legend span:last-child:before{background:#68c7d9}.empty{padding:2.5rem;text-align:center;color:#8a96a8}.top-table th{color:#7c8a9e;font-size:.66rem;letter-spacing:.05em}.top-table td{font-size:.78rem}.score{font-weight:800;color:#1268dd}@@media(max-width:768px){.report-hero{display:block;padding:1.5rem}.hero-rate{margin-top:1.3rem;text-align:left}.bar-row{grid-template-columns:95px 1fr 28px}.trend-chart{gap:.35rem}}
</style>
<div class="report-page">
 <section class="report-hero mb-4"><div><div class="hero-tag"><i class="bi bi-graph-up-arrow me-1"></i> ARS · SYSTEM ANALYTICS</div><h1>Báo cáo vận hành</h1><p>Tổng hợp hiệu quả người dùng, tuyển dụng và doanh thu của hệ thống.</p></div><div class="hero-rate"><span>TỶ LỆ TUYỂN THÀNH CÔNG</span><strong>@Model.ConversionRate%</strong></div></section>
 <div class="row g-3 mb-4">
  <div class="col-md-6 col-xl-3"><div class="report-kpi"><i class="bi bi-people"></i><small>NGƯỜI DÙNG</small><strong>@Model.TotalUsers.ToString("N0")</strong></div></div>
  <div class="col-md-6 col-xl-3"><div class="report-kpi"><i class="bi bi-briefcase"></i><small>TIN TUYỂN DỤNG</small><strong>@Model.ActiveJobs / @Model.TotalJobs</strong><span class="text-muted small"> đang hoạt động</span></div></div>
  <div class="col-md-6 col-xl-3"><div class="report-kpi"><i class="bi bi-file-earmark-person"></i><small>ĐƠN ỨNG TUYỂN</small><strong>@Model.TotalApplications.ToString("N0")</strong></div></div>
  <div class="col-md-6 col-xl-3"><div class="report-kpi"><i class="bi bi-wallet2"></i><small>TỔNG DOANH THU</small><strong>@Model.TotalRevenue.ToString("N0")đ</strong></div></div>
 </div>
 <div class="row g-4 mb-4">
  <div class="col-xl-8"><section class="report-card"><div class="report-head"><h2>Xu hướng tăng trưởng 6 tháng</h2><p>So sánh số người dùng mới và đơn ứng tuyển phát sinh</p></div><div class="trend-chart">@for(var i=0;i<Model.MonthlyApplications.Count;i++){var apps=Model.MonthlyApplications[i];var users=Model.MonthlyUsers[i];<div class="trend-group"><div class="trend-bar trend-app" title="@apps.Value đơn ứng tuyển" style="height:@Math.Max(2,apps.Value*100/trendMax)%"></div><div class="trend-bar trend-user" title="@users.Value người dùng" style="height:@Math.Max(2,users.Value*100/trendMax)%"></div><span class="trend-label">@apps.Label</span></div>}</div><div class="legend"><span>Đơn ứng tuyển</span><span>Người dùng mới</span></div></section></div>
  <div class="col-xl-4"><section class="report-card"><div class="report-head"><h2>Trạng thái đơn ứng tuyển</h2><p>@Model.SuccessfulApplications hồ sơ đã vào vòng phỏng vấn/đạt</p></div><div class="bars">@foreach(var x in Model.ApplicationsByStatus){var max=Math.Max(Model.ApplicationsByStatus.Max(y=>y.Value),1);<div class="bar-row"><span class="bar-label" title="@x.Label">@x.Label</span><div class="bar-track"><div class="bar-fill" style="width:@(x.Value*100/max)%"></div></div><strong>@x.Value</strong></div>}@if(!Model.ApplicationsByStatus.Any()){<div class="empty">Chưa có đơn ứng tuyển.</div>}</div></section></div>
 </div>
 <div class="row g-4 mb-4">
  <div class="col-xl-5"><section class="report-card"><div class="report-head"><h2>Người dùng theo vai trò</h2><p>Cơ cấu tài khoản hiện tại</p></div><div class="bars">@foreach(var x in Model.UsersByRole){var max=Math.Max(Model.UsersByRole.Max(y=>y.Value),1);<div class="bar-row"><span class="bar-label">@x.Label</span><div class="bar-track"><div class="bar-fill" style="width:@(x.Value*100/max)%"></div></div><strong>@x.Value</strong></div>}</div></section></div>
  <div class="col-xl-7"><section class="report-card"><div class="report-head"><h2>Tin tuyển dụng theo ngành</h2><p>Những lĩnh vực đang có nhu cầu tuyển dụng</p></div><div class="bars">@foreach(var x in Model.JobsByCategory.Take(8)){var max=Math.Max(Model.JobsByCategory.Max(y=>y.Value),1);<div class="bar-row"><span class="bar-label" title="@x.Label">@x.Label</span><div class="bar-track"><div class="bar-fill" style="width:@(x.Value*100/max)%"></div></div><strong>@x.Value</strong></div>}@if(!Model.JobsByCategory.Any()){<div class="empty">Chưa có tin tuyển dụng.</div>}</div></section></div>
 </div>
 <section class="report-card"><div class="report-head d-flex justify-content-between"><div><h2>Hiệu suất tin tuyển dụng</h2><p>Các vị trí thu hút nhiều hồ sơ nhất</p></div><div class="text-end"><small class="text-muted">Điểm AI trung bình</small><strong class="d-block text-primary">@Model.AverageAiScore</strong></div></div><div class="table-responsive"><table class="table table-hover align-middle mb-0 top-table"><thead class="table-light"><tr><th>Vị trí</th><th>Công ty</th><th>Hồ sơ</th><th>Điểm AI TB</th><th>Đạt / phỏng vấn</th></tr></thead><tbody>@foreach(var job in Model.TopJobs){<tr><td class="fw-bold">@job.Title</td><td>@job.Company</td><td>@job.Applications</td><td class="score">@Math.Round(job.AverageScore,1)</td><td><span class="badge bg-success bg-opacity-10 text-success">@job.Accepted</span></td></tr>}@if(!Model.TopJobs.Any()){<tr><td colspan="5" class="empty">Chưa có dữ liệu tuyển dụng.</td></tr>}</tbody></table></div></section>
</div>
