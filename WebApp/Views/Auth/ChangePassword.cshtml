@model WebApp.Models.Auth.ChangePasswordViewModel
@{ Layout = User.IsInRole("Recruiter") ? "_RecruiterLayout" : User.IsInRole("Admin") ? "_AdminLayout" : "_Layout"; ViewData["Title"] = "Đổi mật khẩu"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-6"><div class="ui-page-heading mb-4"><div><span class="ui-eyebrow"><i class="bi bi-shield-lock"></i> Bảo mật tài khoản</span><h1>Đổi mật khẩu</h1><p>Cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p></div></div><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5">@if (TempData["PasswordSuccess"] != null){<div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@TempData["PasswordSuccess"]</div>}<form asp-action="ChangePassword" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><div class="mb-3"><label asp-for="CurrentPassword" class="form-label fw-semibold">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="text-danger small"></span></div><div class="mb-3"><label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label><input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger small"></span></div><div class="mb-4"><label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div><button class="btn btn-primary fw-semibold px-4" type="submit"><i class="bi bi-key-fill me-1"></i>Cập nhật mật khẩu</button></form></div></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
