@model WebApp.Models.Auth.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0 rounded-3">
                <div class="card-body p-4 p-sm-5">

                    <h3 class="card-title text-center mb-4 fw-bold text-primary">
                        ĐĂNG NHẬP
                    </h3>
                    <p class="text-muted text-center small mb-4">Chào mừng bạn trở lại! Vui lòng điền thông tin tài khoản.</p>

                    <!-- Form gửi dữ liệu dạng POST tới hành động Login -->
                    <form asp-action="Login" asp-controller="Auth" method="post">

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>
                        }

                        <!-- Trường nhập Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold">Địa chỉ Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Trường nhập Mật khẩu -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold">Mật khẩu</label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" id="loginPassword" class="form-control" placeholder="Nhập mật khẩu của bạn" />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <!-- Sử dụng text đơn giản nếu chưa cài Bootstrap Icon, hoặc dùng icon mắt -->
                                    <span id="eyeIcon">Hiện</span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Nút Đăng nhập -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fs-6 fw-semibold rounded-2 py-2 shadow-sm">
                                Đăng Nhập
                            </button>
                        </div>
                    </form>

                    <hr class="text-muted my-4">

                    <!-- Đường dẫn chuyển sang trang đăng ký -->
                    <div class="text-center small">
                        Bạn chưa có tài khoản?
                        <a asp-action="Register" asp-controller="Auth" class="text-decoration-none fw-semibold text-primary">Đăng ký ứng viên ngay</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Giúp kiểm tra bỏ trống/sai định dạng email ngay tại Client -->
    <partial name="_ValidationScriptsPartial" />

    <!-- JavaScript xử lý ẩn/hiển thị mật khẩu -->
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const passwordInput = document.getElementById('loginPassword');
            const eyeIcon = document.getElementById('eyeIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.textContent = 'Ẩn';
            } else {
                passwordInput.type = 'password';
                eyeIcon.textContent = 'Hiện';
            }
        });
    </script>
}