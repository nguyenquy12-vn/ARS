@model WebApp.Models.Auth.ResetPasswordViewModel
@{ Layout = null; ViewData["Title"] = "Đặt lại mật khẩu | ARS Recruitment"; }
<!doctype html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@ViewData["Title"]</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/auth-flow.css" asp-append-version="true"></head><body><div class="flow-shell"><partial name="_AuthShowcase" /><main class="flow-panel"><section class="flow-card"><a class="flow-back" asp-action="Login"><i class="bi bi-arrow-left"></i> Quay lại đăng nhập</a><h1>Đặt lại mật khẩu</h1><p class="intro">Nhập OTP đã gửi tới <strong>@ViewBag.Email</strong> và mật khẩu mới.</p><form asp-action="ResetPassword" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div><div class="mb-3"><label asp-for="Otp" class="form-label">Mã OTP</label><input asp-for="Otp" class="form-control" inputmode="numeric" maxlength="6" placeholder="6 chữ số"><span asp-validation-for="Otp" class="text-danger small"></span></div><div class="mb-3"><label asp-for="NewPassword" class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự"><span asp-validation-for="NewPassword" class="text-danger small"></span></div><div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label><input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu"><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div><button class="btn btn-primary w-100 mt-2" type="submit">Lưu mật khẩu mới <i class="bi bi-check2 ms-1"></i></button></form></section></main></div><script src="~/lib/jquery/dist/jquery.min.js"></script><partial name="_ValidationScriptsPartial" /></body></html>
