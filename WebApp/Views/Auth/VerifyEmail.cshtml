@model WebApp.Models.Auth.VerifyEmailOtpViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Xác thực email";
    var email = ViewBag.Email as string ?? "email của bạn";
}

<div class="container my-5 py-3">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-sm-5 text-center">
                    <div class="mx-auto mb-4" style="width:68px;height:68px;border-radius:22px;background:#eaf4ff;color:#1267e9;font-size:1.8rem;place-items:center;display:grid;"><i class="bi bi-envelope-check-fill"></i></div>
                    <h2 class="fw-bold mb-2">Xác thực email</h2>
                    <p class="text-muted small mb-4">Mã gồm 6 chữ số đã được gửi tới<br /><strong class="text-dark">@email</strong></p>

                    @if (TempData["OtpSuccess"] != null)
                    {
                        <div class="alert alert-success small py-2 text-start"><i class="bi bi-check-circle-fill me-2"></i>@TempData["OtpSuccess"]</div>
                    }
                    @if (TempData["OtpError"] != null)
                    {
                        <div class="alert alert-danger small py-2 text-start"><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["OtpError"]</div>
                    }

                    <form asp-action="VerifyEmail" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small text-start mb-2"></div>
                        <div class="mb-3">
                            <input asp-for="Otp" class="form-control form-control-lg text-center fw-bold" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="• • • • • •" style="letter-spacing:.55rem;border-radius:14px;" />
                            <span asp-validation-for="Otp" class="text-danger small"></span>
                        </div>
                        <button class="btn btn-primary w-100 fw-semibold py-2 rounded-3" type="submit">Xác thực và tạo tài khoản <i class="bi bi-arrow-right ms-1"></i></button>
                    </form>

                    <form asp-action="ResendOtp" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-link text-decoration-none small fw-semibold" type="submit"><i class="bi bi-arrow-repeat me-1"></i>Gửi lại mã OTP</button>
                    </form>
                    <p class="small text-muted mb-0">Mã có hiệu lực trong 10 phút.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('[name="Otp"]').addEventListener('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
        });
    </script>
}
