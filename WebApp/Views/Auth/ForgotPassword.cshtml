@model WebApp.Models.Auth.ForgotPasswordViewModel
@{ Layout = null; ViewData["Title"] = "Quên mật khẩu | ARS Recruitment"; }
<!doctype html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@ViewData["Title"]</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/auth-flow.css" asp-append-version="true"></head><body><div class="flow-shell"><partial name="_AuthShowcase" /><main class="flow-panel"><section class="flow-card"><a class="flow-back" asp-action="Login"><i class="bi bi-arrow-left"></i> Quay lại đăng nhập</a><h1>Quên mật khẩu?</h1><p class="intro">Nhập Gmail đăng ký, chúng tôi sẽ gửi mã OTP để bạn đặt lại mật khẩu.</p><form asp-action="ForgotPassword" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div><div class="mb-3"><label asp-for="Email" class="form-label">Địa chỉ email</label><input asp-for="Email" class="form-control" placeholder="name@gmail.com" autocomplete="email"><span asp-validation-for="Email" class="text-danger small"></span></div><button class="btn btn-primary w-100 mt-2" type="submit">Gửi mã OTP <i class="bi bi-send ms-1"></i></button></form><p class="switch">Nhớ mật khẩu rồi? <a asp-action="Login">Đăng nhập</a></p></section></main></div><script src="~/lib/jquery/dist/jquery.min.js"></script><partial name="_ValidationScriptsPartial" /></body></html>
