@model WebApp.Models.Auth.RegisterViewModel
@{ Layout = null; ViewData["Title"] = "Tạo tài khoản | ARS Recruitment"; }
<!doctype html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@ViewData["Title"]</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/auth-flow.css" asp-append-version="true"></head><body><div class="flow-shell"><partial name="_AuthShowcase" /><main class="flow-panel"><section class="flow-card"><a class="flow-back" asp-action="Login"><i class="bi bi-arrow-left"></i> Quay lại đăng nhập</a><h1>Tạo tài khoản</h1><p class="intro">Bắt đầu tìm kiếm cơ hội phù hợp với bạn.</p><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div><div class="mb-3"><label asp-for="FullName" class="form-label">Họ và tên</label><input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A"><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Email" class="form-label">Địa chỉ email</label><input asp-for="Email" class="form-control" placeholder="name@gmail.com"><span asp-validation-for="Email" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu</label><input asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự"><span asp-validation-for="Password" class="text-danger small"></span></div><div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu"><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div><button class="btn btn-primary w-100 mt-2" type="submit">Nhận mã xác thực email <i class="bi bi-arrow-right ms-1"></i></button></form><p class="switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p><p class="flow-note"><i class="bi bi-shield-check"></i> OTP Gmail xác thực trước khi tạo tài khoản</p></section></main></div><script src="~/lib/jquery/dist/jquery.min.js"></script><partial name="_ValidationScriptsPartial" /></body></html>
